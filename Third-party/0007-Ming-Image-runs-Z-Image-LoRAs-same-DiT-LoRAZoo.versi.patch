diff --git a/Libraries/ModelZoo/Sources/LoRAZoo.swift b/Libraries/ModelZoo/Sources/LoRAZoo.swift
index 811c06b..56bb074 100644
--- a/Libraries/ModelZoo/Sources/LoRAZoo.swift
+++ b/Libraries/ModelZoo/Sources/LoRAZoo.swift
@@ -338,6 +338,17 @@ public struct LoRAZoo: DownloadZoo {
     return specification.version
   }
 
+  /// The version a LoRA runs as with a model of `modelVersion`. Ming-Image's DiT is Z-Image's
+  /// graph with the same weight names, so a Z-Image LoRA runs on it as a Ming-Image LoRA
+  /// (its text-encoder part, for Qwen3, is not used: Ming's encoder takes no LoRA).
+  public static func versionForModel(_ name: String, runningWith modelVersion: ModelVersion)
+    -> ModelVersion
+  {
+    let version = versionForModel(name)
+    if modelVersion == .mingImage && version == .zImage { return .mingImage }
+    return version
+  }
+
   public static func modifierForModel(_ name: String) -> SamplerModifier {
     guard let specification = specificationForModel(name) else { return .none }
     return specification.modifier ?? .none
