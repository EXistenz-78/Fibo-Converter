-  if roundUpHW != h * w {
+  if roundUpHW != imageTokenCount {
     let padTokens = Input()
     xOut = Functional.concat(axis: 1, xOut, padTokens, flags: .disableOpt)
     xPadTokens = padTokens
@@ -1516,6 +1524,7 @@ public func LoRAZImage(
   inputs.append(rot)
   inputs.append(txtIn)
   inputs.append(contentsOf: adaLNChunks)
+  inputs.append(contentsOf: references)
   return (
     Model(inputs, [out], trainable: false), mapper
