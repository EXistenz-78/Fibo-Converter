-  var xOut = imgIn(
-    x.reshaped([batchSize, h, 2, w, 2, 16]).permuted(0, 1, 3, 2, 4, 5).contiguous()
-      .reshaped([batchSize, h * w, 2 * 2 * 16], format: .NHWC)
-  )
+  func patches(_ latent: Model.IO) -> Model.IO {
+    imgIn(
+      latent.reshaped([batchSize, h, 2, w, 2, 16]).permuted(0, 1, 3, 2, 4, 5).contiguous()
+        .reshaped([batchSize, h * w, 2 * 2 * 16], format: .NHWC))
+  }
+  var xOut = patches(x)
+  // Ming-Image's references, as in `ZImage`: one frame each after the image.
+  let references = (0..<referenceCount).map { _ in Input() }
+  for reference in references {
+    xOut = Functional.concat(axis: 1, xOut, patches(reference), flags: .disableOpt)
+  }
+  let imageTokenCount = h * w * (1 + referenceCount)
   var mappers = [ModelWeightMapper]()
   var adaLNChunks = [Input]()
-  let roundUpHW = (h * w + 31) / 32 * 32
