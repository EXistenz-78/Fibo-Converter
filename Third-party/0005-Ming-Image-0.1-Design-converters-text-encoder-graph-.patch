+  /// Converts Ming-Image's VAE with the Wan VAE graph (RGBA on both ends): `__encoder__[...]`,
+  /// `__decoder__[...]`, as the engine reads them.
+  private func convertMingVAE() throws {
+    guard let safeTensors = SafeTensors(url: URL(fileURLWithPath: file)) else {
+      throw MingTextEncoderError.cannotOpenFile(file)
+    }
+    let states = safeTensors.states
+    let graph = DynamicGraph()
+    let fileName = Importer.cleanup(filename: name)
+    let outputPath = URL(fileURLWithPath: outputDirectory)
+      .appendingPathComponent("\(fileName)_f16.ckpt").path
+    let side = 64
+    var written = Set<String>()
+    try graph.withNoGrad {
+      let (decoderMapper, decoder) = MingVAEDecoder(width: side / 8, height: side / 8)
+      let (encoderMapper, encoder) = MingVAEEncoder(width: side / 8, height: side / 8)
+      decoder.compile(inputs: graph.variable(.GPU(0), .NHWC(1, side / 8, side / 8, 16), of: FloatType.self))
+      encoder.compile(inputs: graph.variable(.GPU(0), .NHWC(1, side, side, 4), of: FloatType.self))
+      try graph.openStore(outputPath) { store in
+        store.removeAll()
+        try store.withTransaction {
+          for (mapper, prefix) in [(decoderMapper, "__decoder__"), (encoderMapper, "__encoder__")] {
+            for (key, element) in mapper(.diffusers).sorted(by: { $0.key < $1.key }) {
+              guard let descriptor = states[key] else { throw MingTextEncoderError.missingTensor(key) }
+              written.insert(key)
+              try safeTensors.with(descriptor) { source in
+                element.write(
+                  graph: graph, to: store, tensor: Tensor<FloatType>(from: source),
+                  format: element.format, isDiagonalUp: false, isDiagonalDown: false
+                ) { "\(prefix)[\($0)]" }
+              }
+            }
+          }
+        }
+      }
+    }
+    let unused = Set(states.keys).subtracting(written)
+    print("Wrote \(outputPath): \(written.count) of \(states.count) tensors used")
+    if !unused.isEmpty {
+      print("Not used: \(unused.sorted().prefix(10))")
+    }
+  }
+
+  /// The raw bytes of one tensor of a safetensors file (the header is 8 bytes of length and JSON).
+  private static func safetensorsBytes(of name: String, in url: URL) throws -> Data {
+    let handle = try FileHandle(forReadingFrom: url)
+    defer { try? handle.close() }
+    let lengthBytes = try handle.read(upToCount: 8) ?? Data()
+    let headerLength = lengthBytes.withUnsafeBytes { Int($0.loadUnaligned(as: UInt64.self)) }
+    let header = try handle.read(upToCount: headerLength) ?? Data()
+    guard
+      let json = try JSONSerialization.jsonObject(with: header) as? [String: Any],
+      let entry = json[name] as? [String: Any],
+      let offsets = entry["data_offsets"] as? [Int], offsets.count == 2
+    else { throw MingTextEncoderError.missingTensor(name) }
+    try handle.seek(toOffset: UInt64(8 + headerLength + offsets[0]))
+    return try handle.read(upToCount: offsets[1] - offsets[0]) ?? Data()
+  }
+
   private enum Fibo2TextEncoderError: Error {
     case cannotOpenFile(String)
     case missingTensor(String)
