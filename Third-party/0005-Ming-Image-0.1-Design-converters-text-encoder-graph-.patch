+++ b/Apps/MingDiTTest/main.swift
@@ -0,0 +1,236 @@
+import Diffusion
+import Foundation
+import NNC
+
+// One forward pass of Ming-Image's diffusion transformer from the converted checkpoint, compared
+// with the PyTorch reference (Tools/ming-reference/ref_dit.py in DT Hub).
+//
+// Usage: MingDiTTest <design.ckpt> <ref_encoder.safetensors> <ref_dit.safetensors>
+
+typealias Half = Float16
+
+let arguments = CommandLine.arguments
+guard arguments.count >= 4 else {
+  print("Usage: MingDiTTest <design.ckpt> <ref_encoder.safetensors> <ref_dit.safetensors>")
+  exit(2)
+}
+let checkpoint = arguments[1]
+guard let encoderReference = SafeTensors(url: URL(fileURLWithPath: arguments[2])),
+  let ditReference = SafeTensors(url: URL(fileURLWithPath: arguments[3]))
+else { fatalError("Cannot open the references") }
+func tensor(_ file: SafeTensors, _ name: String) -> Tensor<Float> {
+  try! file.with(file.states[name]!) { Tensor<Float>(from: $0).toCPU() }
+}
+
+let graph = DynamicGraph()
+let codec: DynamicGraph.Store.Codec = [.jit, .q6p, .q8p, .i8x, .ezm7, .externalData]
+let isBF16 = ProcessInfo.processInfo.environment["MING_BF16"] != nil
+let refinerLayers = Int(ProcessInfo.processInfo.environment["MING_REFINERS"] ?? "2")!
+let channels = 3_840
+let layers = Int(ProcessInfo.processInfo.environment["MING_LAYERS"] ?? "30")!
+
+let queries = tensor(encoderReference, "query_embeds")  // [256, 2560]
+let direct = tensor(encoderReference, "directvlm")  // [L, 3840]
+let latents = tensor(ditReference, "latents")  // [1, h, w, 16]
+let expected = tensor(ditReference, "output")
+let timestepInput = tensor(ditReference, "timestep")[0]  // (1000 - sigma * 1000) / 1000
+let queryLength = queries.shape[0]
+let directLength = direct.shape[0]
+let captionLength = queryLength + directLength
+let paddedCaptionLength = (captionLength + 31) / 32 * 32
+let height = latents.shape[1]
+let width = latents.shape[2]
+print("Caption \(captionLength) tokens (padded \(paddedCaptionLength)), latents \(height)x\(width)")
+
+func half(_ source: Tensor<Float>, _ shape: TensorShapeFormat) -> DynamicGraph.Tensor<Half> {
+  var result = Tensor<Half>(.CPU, shape)
+  let count = source.shape.reduce(1, *)
+  precondition(count == result.shape.reduce(1, *))
+  source.withUnsafeBytes { raw in
+    let values = raw.baseAddress!.assumingMemoryBound(to: Float.self)
+    result.withUnsafeMutableBytes { target in
+      let out = target.baseAddress!.assumingMemoryBound(to: Half.self)
+      for i in 0..<count { out[i] = Half(values[i]) }
+    }
+  }
+  return graph.variable(result.toGPU(0))
+}
+
+if ProcessInfo.processInfo.environment["MING_BF16TEST"] != nil {
+  var floats = Tensor<Float>(.CPU, .WC(1, 8))
+  for i in 0..<8 { floats[0, i] = Float(i) * 0.37 - 1.1 }
+  let bf = Tensor<BFloat16>(from: floats)
+  let h = Tensor<Float16>(from: bf)
+  let back = Tensor<Float>(from: h)
+  let viaFloat = Tensor<Float>(from: bf)
+  print("float -> bf16 -> float:", (0..<8).map { viaFloat[0, $0] })
+  let direct = Tensor<Float16>(from: floats)
+  print("float -> f16:", (0..<8).map { Float(direct[0, $0]) })
+  print("float -> bf16 -> f16 -> float:", (0..<8).map { back[0, $0] }, "from", (0..<8).map { floats[0, $0] })
+  exit(0)
+}
+if let sourcePath = ProcessInfo.processInfo.environment["MING_SOURCE"] {
+  // Does the quantized checkpoint hold the source's weights? Compare one matrix.
+  guard let source = SafeTensors(url: URL(fileURLWithPath: sourcePath)) else { fatalError() }
+  let pairs = [
+    ("__dit__[t-context_refiner_k-0-0]", "context_refiner.0.attention.to_k.weight"),
+    ("__dit__[t-context_refiner_v-0-0]", "context_refiner.0.attention.to_v.weight"),
+    ("__dit__[t-context_refiner_q-0-0]", "context_refiner.0.attention.to_q.weight"),
+  ]
+  for (key, sourceKey) in pairs {
+    var stored: Tensor<Float>? = nil
+    graph.openStore(checkpoint, flags: .readOnly) { store in
+      stored = store.read(key, kind: .CPU, codec: [.q6p, .q8p, .i8x, .ezm7, .externalData]).map { Tensor<Float>(from: $0).toCPU() }
+    }
+    let original = try! source.with(source.states[sourceKey]!) { Tensor<Float>(from: $0).toCPU() }
+    guard let stored else { print("\(key): missing"); continue }
+    var difference = 0.0
+    var norm = 0.0
+    var swappedDifference = 0.0
+    for i in 0..<64 {
+      for j in 0..<channels {
+        let a = Double(stored[i, j])
+        let b = Double(original[i, j])
+        difference += (a - b) * (a - b)
+        norm += b * b
+      }
+    }
+    print("\(key) vs \(sourceKey): relative error \(String(format: "%.5f", (difference / norm).squareRoot())) (first 64 rows)")
+    _ = swappedDifference
+  }
+  exit(0)
+}
+
+try graph.withNoGrad {
+  let txt = half(queries, .HWC(1, queryLength, 2_560))
+  let directTokens = half(direct, .HWC(1, directLength, channels))
+  let x = half(latents, .NHWC(1, height, width, 16))
+
+  // The time embedding of 1000 * timestepInput: cos then sin of t * exp(-ln(10000) i / 128).
+  var timeEmbedding = Tensor<Half>(.CPU, .WC(1, 256))
+  for i in 0..<128 {
+    let frequency = exp(-log(10_000.0) * Double(i) / 128)
+    let angle = Double(timestepInput) * 1_000 * frequency
+    timeEmbedding[0, i] = Half(cos(angle))
+    timeEmbedding[0, 128 + i] = Half(sin(angle))
+  }
+  let timeEmbeds = graph.variable(timeEmbedding.toGPU(0))
+
+  let captionRotary = graph.variable(
+    Tensor<Half>(
+      from: ZImageRotaryPositionEmbedding(
+        height: 0, width: 0, tokenLength: captionLength, imagePaddedLength: 0)
+    ).toGPU(0))
+  let tokensHeight = height / 2
+  let tokensWidth = width / 2
+  precondition((tokensHeight * tokensWidth) % 32 == 0, "image tokens would need padding")
+  let imageRotary = graph.variable(
+    Tensor<Half>(
+      from: ZImageRotaryPositionEmbedding(
+        height: tokensHeight, width: tokensWidth, tokenLength: captionLength,
+        imagePaddedLength: 0, imageTimePosition: paddedCaptionLength)
+    ).toGPU(0))
+
+  let flash: FlashAttentionLevel = ProcessInfo.processInfo.environment["MING_FLASH"] == "merged" ? .scaleMerged : .scale1
+  let (fixed, _) = MingImageFixed(
+    batchSize: 1, queryLength: queryLength, directLength: directLength, channels: channels,
+    layers: layers, activationQkScaling: [:], activationProjScaling: [:],
+    activationFfnProjUpScaling: [:], activationFfnScaling: [:], usesFlashAttention: flash,
+    isBF16: isBF16, contextRefinerLayers: refinerLayers)
+  fixed.compile(inputs: txt, directTokens, captionRotary, timeEmbeds)
+  graph.openStore(checkpoint, flags: .readOnly) { store in
+    do {
+      try store.read("dit", model: fixed, strict: true, codec: codec) { name, dataType, format, shape in
+        if ProcessInfo.processInfo.environment["MING_TRACE"] != nil {
+          FileHandle.standardError.write(Data("read \(name) \(dataType) \(shape)\n".utf8))
+        }
+        return .continue(name)
+      }
+    } catch {
+      print("  ! reading the fixed part: \(error)")
+    }
+  }
+  let fixedOutputs = fixed(inputs: txt, directTokens, captionRotary, timeEmbeds)
+  print("Fixed outputs: \(fixedOutputs.count)")
+  func relative(_ mine: Tensor<Float>, _ theirs: Tensor<Float>, rows: Int, columns: Int, offset: Int = 0) -> Double {
+    var difference = 0.0
+    var norm = 0.0
+    for i in 0..<rows {
+      for j in 0..<columns {
+        let m = mine.shape.count == 3 ? mine[0, i, j] : mine[i, j]
+        let d = Double(m - theirs[i + offset, j])
+        difference += d * d
+        norm += Double(theirs[i + offset, j] * theirs[i + offset, j])
+      }
+    }
+    return (difference / norm).squareRoot()
+  }
+  do {
+    // cap_norm + cap_embedder alone, on the 256 queries.
+    let norm = RMSNorm(epsilon: 1e-5, axis: [2], name: "cap_norm")
+    let embedder = Dense(count: channels, name: "cap_embedder")
+    let input = Input()
+    let probe = Model([input], [embedder(norm(input))])
+    probe.compile(inputs: txt)
+    graph.openStore(checkpoint, flags: .readOnly) { store in
+      store.read("dit", model: probe, codec: codec)
+    }
+    let embedded = probe(inputs: txt)[0].as(of: Half.self)
+    let mine = Tensor<Float>(from: embedded.rawValue.toCPU())
+    print(
+      "cap_embedder (queries) vs PyTorch: relative error \(String(format: "%.5f", relative(mine, tensor(ditReference, "cap_embedded"), rows: queryLength, columns: channels)))"
+    )
+  }
+  do {
+    // The refined caption (FP32) against the reference's, without its padding rows.
+    let mine = Tensor<Float>(from: fixedOutputs[0].as(of: Float.self).rawValue.toCPU())
+    let theirs = tensor(
+      ditReference,
+      refinerLayers == 0 ? "cap_embedded" : (refinerLayers == 1 ? "cap_refiner0" : "cap_refined"))
+    var difference = 0.0
+    var norm = 0.0
+    for i in 0..<captionLength {
+      for j in 0..<channels {
+        let d = Double(mine[0, i, j] - theirs[i, j])
+        difference += d * d
+        norm += Double(theirs[i, j] * theirs[i, j])
+      }
+    }
+    print("refined caption vs PyTorch: relative error \(String(format: "%.5f", (difference / norm).squareRoot()))")
+  }
+
+  let (unet, _) = ZImage(
+    batchSize: 1, height: height, width: width, textLength: captionLength, channels: channels,
+    layers: layers, activationQkScaling: [:], activationProjScaling: [:],
+    activationFfnProjUpScaling: [:], activationFfnScaling: [:], usesFlashAttention: flash,
+    isBF16: isBF16)
+  var inputs: [DynamicGraph.AnyTensor] = [x, imageRotary]
+  inputs.append(contentsOf: fixedOutputs)
+  unet.compile(inputs: inputs)
+  graph.openStore(checkpoint, flags: .readOnly) { store in
+    do { try store.read("dit", model: unet, strict: true, codec: codec) } catch {
+      print("  ! reading the transformer: \(error)")
+    }
+  }
+  let output = unet(inputs: x, Array(inputs.dropFirst()))[0].as(of: Half.self)
+  // The engine's graph negates the output (the reference's pipeline does it after the model).
+  let result = Tensor<Float>(from: output.rawValue.toCPU())
+  var difference = 0.0
+  var norm = 0.0
+  var worst: Float = 0
+  for y in 0..<height {
+    for xx in 0..<width {
+      for c in 0..<16 {
+        let mine = -result[0, y, xx, c]
+        let theirs = expected[0, y, xx, c]
+        let d = Double(mine - theirs)
+        difference += d * d
+        norm += Double(theirs * theirs)
+        worst = max(worst, abs(mine - theirs))
+      }
+    }
+  }
+  print(
+    "DiT output vs PyTorch: relative error \(String(format: "%.5f", (difference / norm).squareRoot())), max |diff| \(worst)"
+  )
+}
diff --git a/Apps/MingEncoderTest/main.swift b/Apps/MingEncoderTest/main.swift
new file mode 100644
index 0000000..977842d
--- /dev/null
+++ b/Apps/MingEncoderTest/main.swift
@@ -0,0 +1,243 @@
+import Diffusion
+import Foundation
+import NNC
+
+// Runs Ming-Image's Ling language model layer by layer from the converted checkpoint and compares
+// each layer's output with the PyTorch reference (Tools/ming-reference/ref_encoder.py in DT Hub).
+//
+// Usage: MingEncoderTest <reference.safetensors> <ming_image_ling_mini_2.0_f16.ckpt> [layers]
+
+typealias Half = Float16
+
+let arguments = CommandLine.arguments
+guard arguments.count >= 3 else {
+  print("Usage: MingEncoderTest <reference.safetensors> <encoder.ckpt> [layers]")
+  exit(2)
+}
+let layerLimit = arguments.count > 3 ? Int(arguments[3])! : 20
+let configuration = MingLingConfiguration.ming
+
+guard let reference = SafeTensors(url: URL(fileURLWithPath: arguments[1])) else {
+  fatalError("Cannot open \(arguments[1])")
+}
+func referenceTensor(_ name: String) -> Tensor<Float> {
+  guard let descriptor = reference.states[name] else { fatalError("No \(name) in the reference") }
+  return try! reference.with(descriptor) { Tensor<Float>(from: $0).toCPU() }
+}
+
+let checkpoint = arguments[2]
+let graph = DynamicGraph()
+let codec: DynamicGraph.Store.Codec = [.ezm7, .q8p, .q6p, .q4p, .i8x, .jit, .externalData]
+
+func read(_ model: Model, _ label: String, key: String = "ming_text", path: String? = nil) {
+  graph.openStore(path ?? checkpoint, flags: .readOnly) { store in
+    do {
+      try store.read(key, model: model, strict: true, codec: codec)
+    } catch {
+      print("  ! reading \(label): \(error)")
+    }
+  }
+}
+
+func compare(_ label: String, _ value: Tensor<Float>, _ expected: Tensor<Float>) {
+  let rows = expected.shape[0]
+  let columns = expected.shape.count > 1 ? expected.shape[1] : 1
+  precondition(value.shape[0] == rows, "\(label): \(value.shape) vs \(expected.shape)")
+  var maxDifference: Float = 0
+  var squares = 0.0
+  var expectedSquares = 0.0
+  var worst = (0, 0)
+  for i in 0..<rows {
+    for j in 0..<columns {
+      let a = expected.shape.count > 1 ? value[i, j] : value[i]
+      let b = expected.shape.count > 1 ? expected[i, j] : expected[i]
+      let d = abs(a - b)
+      if d > maxDifference {
+        maxDifference = d
+        worst = (i, j)
+      }
+      squares += Double(d * d)
+      expectedSquares += Double(b * b)
+    }
+  }
+  let relative = (squares / max(expectedSquares, 1e-30)).squareRoot()
+  let status = relative < 2e-2 ? "ok " : "BAD"
+  print(
+    "\(status) \(label): relative error \(String(format: "%.5f", relative)), max |diff| \(maxDifference) at \(worst)"
+  )
+}
+
+// Reference inputs.
+let idsReference = referenceTensor("ids")
+let tokenLength = idsReference.shape[0]
+let ids = (0..<tokenLength).map { Int32(idsReference[$0]) }
+let positionsReference = referenceTensor("positions")
+let positions = (0..<3).map { row in (0..<tokenLength).map { Int(positionsReference[row, $0]) } }
+let patchToken: Int32 = 157_157
+let isPatch = ids.map { $0 == patchToken }
+print("Tokens: \(tokenLength), query tokens: \(isPatch.filter { $0 }.count)")
+
+try graph.withNoGrad {
+  // Embedding, with the learnable queries in the patch rows.
+  var queries: Tensor<Float>? = nil
+  graph.openStore(checkpoint, flags: .readOnly) { store in
+    if let tensor = store.read("query_tokens") {
+      queries = Tensor<Float>(from: tensor).toCPU()
+    }
+  }
+  guard let queries else { fatalError("query_tokens is missing from the checkpoint") }
+  var keep = Tensor<Float>(.CPU, .WC(tokenLength, 1))
+  var injected = Tensor<Float>(.CPU, .WC(tokenLength, configuration.hiddenSize))
+  var queryRow = 0
+  for i in 0..<tokenLength {
+    keep[i, 0] = isPatch[i] ? 0 : 1
+    for j in 0..<configuration.hiddenSize {
+      injected[i, j] = isPatch[i] ? queries[queryRow, j] : 0
+    }
+    if isPatch[i] { queryRow += 1 }
+  }
+  let tokensGPU = graph.variable(Tensor<Int32>(ids, .CPU, .C(tokenLength)).toGPU(0))
+  let (_, embedding) = MingLingEmbedding(Half.self, tokenLength: tokenLength)
+  embedding.compile(
+    inputs: tokensGPU, graph.variable(keep.toGPU(0)), graph.variable(injected.toGPU(0)))
+  read(embedding, "embedding")
+  var x = embedding(inputs: tokensGPU, graph.variable(keep.toGPU(0)), graph.variable(injected.toGPU(0)))[0]
+    .as(of: Float.self)
+  compare("hidden_0 (embedding)", x.rawValue.toCPU(), referenceTensor("hidden_0"))
+
+  let rotary = graph.variable(
+    MingLingRotaryEmbedding(positions: positions, of: Half.self).toGPU(0))
+  var mask = Tensor<Half>(
+    Array(repeating: 0, count: tokenLength * tokenLength), .CPU, .NHWC(1, 1, tokenLength, tokenLength))
+  for row in 0..<(tokenLength - 1) {
+    for column in (row + 1)..<tokenLength {
+      mask[0, 0, row, column] = -Half.greatestFiniteMagnitude
+    }
+  }
+  let maskGPU = graph.variable(mask.toGPU(0))
+
+  var saved = [Int: Tensor<Float>]()
+  for layer in 0..<min(layerLimit, configuration.layers) {
+    let (_, attention) = MingLingAttentionHalf(
+      Half.self, layer: layer, tokenLength: tokenLength, usesFlashAttention: true)
+    attention.compile(inputs: x, rotary, maskGPU)
+    read(attention, "layer \(layer) attention")
+    let halves = attention(inputs: x, rotary, maskGPU).map { $0.as(of: Float.self) }
+    let residual = halves[MingLingAttentionOutputs.residual]
+    let normalized = halves[MingLingAttentionOutputs.normalized]
+    if layer < configuration.denseLayers {
+      let (_, dense) = MingLingDenseHalf(Half.self, layer: layer)
+      dense.compile(inputs: residual, normalized)
+      read(dense, "layer \(layer) dense")
+      x = dense(inputs: residual, normalized)[0].as(of: Float.self)
+    } else {
+      // Routing on the host: the image gate for the query rows, the text gate for the rest.
+      let textLogits = halves[MingLingAttentionOutputs.textLogits].rawValue.toCPU()
+      let imageLogits = halves[MingLingAttentionOutputs.imageLogits].rawValue.toCPU()
+      var textBias = Tensor<Float>(.CPU, .C(configuration.experts))
+      var imageBias = Tensor<Float>(.CPU, .C(configuration.experts))
+      graph.openStore(checkpoint, flags: .readOnly) { store in
+        if let t = store.read("layers.\(layer).gate.expert_bias") {
+          textBias = Tensor<Float>(from: t).toCPU()
+        }
+        if let t = store.read("layers.\(layer).image_gate.expert_bias") {
+          imageBias = Tensor<Float>(from: t).toCPU()
+        }
+      }
+      var chosen = Tensor<Float>(.CPU, .WC(tokenLength, configuration.experts))
+      var scores = [Float](repeating: 0, count: tokenLength * configuration.experts)
+      for i in 0..<tokenLength {
+        for e in 0..<configuration.experts {
+          let logit = isPatch[i] ? imageLogits[i, e] : textLogits[i, e]
+          let bias = isPatch[i] ? imageBias[e] : textBias[e]
+          chosen[i, e] = logit
+          scores[i * configuration.experts + e] = 1 / (1 + exp(-logit)) + bias
+        }
+      }
+      let selected = MingLingSelectExperts(scoresWithBias: scores, tokenLength: tokenLength)
+      if layer == 1 {
+        // Layer 1's routing in the reference: the experts per token, order aside.
+        let expectedIndex = referenceTensor("router_l1_idx")
+        var mismatches = 0
+        for i in 0..<tokenLength {
+          let mine = Set(
+            (0..<configuration.expertsPerToken).map { Int(selected[i * configuration.expertsPerToken + $0]) })
+          let theirs = Set((0..<configuration.expertsPerToken).map { Int(expectedIndex[i, $0]) })
+          if mine != theirs { mismatches += 1 }
+        }
+        print("\(mismatches == 0 ? "ok " : "BAD") layer 1 routing: \(mismatches) tokens differ")
+      }
+      let (_, moe) = MingLingMoEHalf(layer: layer, tokenLength: tokenLength)
+      let logitsGPU = graph.variable(chosen.toGPU(0))
+      let selectedGPU = graph.variable(
+        Tensor<Int32>(selected, .CPU, .WC(tokenLength, configuration.expertsPerToken)).toGPU(0))
+      moe.compile(inputs: residual, normalized, logitsGPU, selectedGPU)
+      read(moe, "layer \(layer) MoE")
+      x = moe(inputs: residual, normalized, logitsGPU, selectedGPU)[0].as(of: Float.self)
+    }
+    if layer + 1 == 5 || layer + 1 == 12 { saved[layer + 1] = x.rawValue.toCPU() }
+    if layer + 1 < configuration.layers {
+      compare("hidden_\(layer + 1) (after layer \(layer))", x.rawValue.toCPU(), referenceTensor("hidden_\(layer + 1)"))
+    }
+  }
+  if layerLimit >= configuration.layers {
+    let (_, norm) = MingLingFinalNorm()
+    norm.compile(inputs: x)
+    read(norm, "final norm")
+    let final = norm(inputs: x)[0].as(of: Float.self)
+    let finalCPU = final.rawValue.toCPU()
+    compare("hidden_20 (final norm)", finalCPU, referenceTensor("hidden_20"))
+    saved[20] = finalCPU
