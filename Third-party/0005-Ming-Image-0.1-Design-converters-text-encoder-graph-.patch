+    // Query stream: the 256 query rows -> proj_in -> connector -> proj_out.
+    var queryRowsHalf = Tensor<Half>(.CPU, .WC(256, configuration.hiddenSize))
+    var row = 0
+    for i in 0..<tokenLength where isPatch[i] {
+      for j in 0..<configuration.hiddenSize { queryRowsHalf[row, j] = Half(finalCPU[i, j]) }
+      row += 1
+    }
+    let (_, connector) = MingConnector(Half.self, tokenLength: 256, usesFlashAttention: true)
+    let queryGPU = graph.variable(queryRowsHalf.toGPU(0))
+    let connectorRotary = graph.variable(
+      MingConnectorRotaryEmbedding(length: 256, of: Half.self).toGPU(0))
+    connector.compile(inputs: queryGPU, connectorRotary)
+    read(connector, "connector")
+    let conditioning = connector(inputs: queryGPU, connectorRotary)[0].as(of: Half.self)
+    compare(
+      "query_embeds (connector)", Tensor<Float>(from: conditioning.rawValue.toCPU()),
+      referenceTensor("query_embeds"))
+
+    // The connector alone, fed with the reference's own final hidden states.
+    let referenceFinal = referenceTensor("hidden_20")
+    var referenceRows = Tensor<Half>(.CPU, .WC(256, configuration.hiddenSize))
+    row = 0
+    for i in 0..<tokenLength where isPatch[i] {
+      for j in 0..<configuration.hiddenSize { referenceRows[row, j] = Half(referenceFinal[i, j]) }
+      row += 1
+    }
+    let isolated = connector(inputs: graph.variable(referenceRows.toGPU(0)), connectorRotary)[0]
+      .as(of: Half.self)
+    compare(
+      "query_embeds (connector alone, reference input)",
+      Tensor<Float>(from: isolated.rawValue.toCPU()), referenceTensor("query_embeds"))
+
+    // Second stream: layers 5, 12 and 20 over the prompt tokens.
+    let prefixLength = ids.firstIndex(of: 157_158)!
+    var directInput = Tensor<Half>(.CPU, .WC(prefixLength, 3 * configuration.hiddenSize))
+    for (part, layer) in [5, 12, 20].enumerated() {
+      let source = saved[layer]!
+      for i in 0..<prefixLength {
+        for j in 0..<configuration.hiddenSize {
+          directInput[i, part * configuration.hiddenSize + j] = Half(source[i, j])
+        }
+      }
+    }
+    let (_, direct) = MingDirectVLMProjection(Half.self)
+    let directGPU = graph.variable(directInput.toGPU(0))
+    direct.compile(inputs: directGPU)
+    read(direct, "directvlm")
+    let directOutput = direct(inputs: directGPU)[0].as(of: Half.self)
+    compare(
+      "directvlm", Tensor<Float>(from: directOutput.rawValue.toCPU()), referenceTensor("directvlm"))
+  }
+}
diff --git a/Apps/MingVAETest/main.swift b/Apps/MingVAETest/main.swift
new file mode 100644
index 0000000..1001021
--- /dev/null
+++ b/Apps/MingVAETest/main.swift
@@ -0,0 +1,143 @@
+import Diffusion
+import Foundation
+import NNC
+
+// Round trip through Ming-Image's converted VAE: encode a synthetic RGBA picture, decode the
+// latents, and report how well the picture comes back (PSNR per channel).
+//
+// Usage: MingVAETest <ming_image_vae_f16.ckpt> <reference.safetensors>
+// The reference (Tools/ming-reference/ref_vae.py in DT Hub) holds the picture, its latents and
+// their decoding from PyTorch.
+
+typealias Half = Float16
+
+let arguments = CommandLine.arguments
+guard arguments.count >= 2 else {
+  print("Usage: MingVAETest <vae.ckpt> [size]")
+  exit(2)
+}
+let checkpoint = arguments[1]
+guard arguments.count > 2, let reference = SafeTensors(url: URL(fileURLWithPath: arguments[2]))
+else {
+  print("Usage: MingVAETest <vae.ckpt> <reference.safetensors>")
+  exit(2)
+}
+func referenceTensor(_ name: String) -> Tensor<Float> {
+  try! reference.with(reference.states[name]!) { Tensor<Float>(from: $0).toCPU() }
+}
+let referenceImage = referenceTensor("image")
+let size = referenceImage.shape[1]
+let latentSize = size / 8
+let graph = DynamicGraph()
+let codec: DynamicGraph.Store.Codec = [.ezm7, .jit, .externalData]
+
+/// The engine reads a depth-1 VAE's 3D convolutions (conv_in, conv_out and the residual blocks'
+/// two) by keeping only the last temporal tap, the one a causal convolution applies to a single
+/// frame (FirstStage.swift does the same). The other weights are stored as they are.
+func read(_ model: Model, _ key: String) {
+  graph.openStore(checkpoint, flags: .readOnly) { store in
+    do {
+      try store.read(key, model: model, strict: true, codec: codec) {
+        name, dataType, format, shape in
+        guard
+          name.hasSuffix("-0]")
+            && (name.hasPrefix("__\(key)__[t-conv_in-") || name.hasPrefix("__\(key)__[t-conv_out-")
+              || name.hasPrefix("__\(key)__[t-resnet_conv1-")
+              || name.hasPrefix("__\(key)__[t-resnet_conv2-"))
+        else { return .continue(name) }
+        guard
+          var tensor = store.read(name, kind: .CPU, codec: codec).map({ Tensor<Half>(from: $0) })
+        else { return .continue(name) }
+        let channels = tensor.shape.reduce(1, *) / (3 * 3 * 3)
+        let outChannels = shape.reduce(1, *) / (3 * 3)
+        tensor = tensor.reshaped(.NCHW(channels, 3, 3, 3))
+        guard channels < outChannels else {
+          return .final(tensor[0..<channels, 2..<3, 0..<3, 0..<3].contiguous())
+        }
+        var padded = Tensor<Half>(
+          Array(repeating: 0, count: outChannels * 3 * 3), .CPU, .NCHW(outChannels, 1, 3, 3))
+        padded[0..<channels, 0..<1, 0..<3, 0..<3] = tensor[0..<channels, 2..<3, 0..<3, 0..<3]
+          .contiguous()
+        return .final(padded)
+      }
+    } catch {
+      print("  ! reading \(key): \(error)")
+    }
+  }
+}
+
+var image = Tensor<Half>(.CPU, .NHWC(1, size, size, 4))
+for y in 0..<size {
+  for x in 0..<size {
+    for c in 0..<4 { image[0, y, x, c] = Half(referenceImage[0, y, x, c]) }
+  }
+}
+
+func relativeError(_ a: Tensor<Float>, _ b: Tensor<Float>, _ shape: [Int]) -> Double {
+  var difference = 0.0
+  var norm = 0.0
+  for y in 0..<shape[0] {
+    for x in 0..<shape[1] {
+      for c in 0..<shape[2] {
+        let d = Double(a[0, y, x, c] - b[0, y, x, c])
+        difference += d * d
+        norm += Double(b[0, y, x, c]) * Double(b[0, y, x, c])
+      }
+    }
+  }
+  return (difference / max(norm, 1e-30)).squareRoot()
+}
+
+try graph.withNoGrad {
+  let (_, encoder) = MingVAEEncoder(width: latentSize, height: latentSize)
+  let input = graph.variable(image.toGPU(0))
+  encoder.compile(inputs: input)
+  read(encoder, "encoder")
+  let encoded = encoder(inputs: input)[0].as(of: Half.self)
+  print("Encoder output: \(encoded.shape)")
+  // The first 16 channels are the mean, the rest the log variance.
+  let mean = encoded[0..<1, 0..<latentSize, 0..<latentSize, 0..<16].copied()
+  let latents = Tensor<Float>(from: mean.rawValue.toCPU())
+  var sum = 0.0
+  var squares = 0.0
+  for y in 0..<latentSize {
+    for x in 0..<latentSize {
+      for c in 0..<16 {
+        let value = Double(latents[0, y, x, c])
+        sum += value
+        squares += value * value
+      }
+    }
+  }
+  let count = Double(latentSize * latentSize * 16)
+  print(
+    "latents vs PyTorch: relative error "
+      + String(format: "%.5f", relativeError(latents, referenceTensor("latents"), [latentSize, latentSize, 16])))
+  print(
+    "Latents: mean \(String(format: "%.3f", sum / count)), std \(String(format: "%.3f", (squares / count - (sum / count) * (sum / count)).squareRoot()))"
+  )
+
+  let (_, decoder) = MingVAEDecoder(width: latentSize, height: latentSize)
+  decoder.compile(inputs: mean)
+  read(decoder, "decoder")
+  let decoded = decoder(inputs: mean)[0].as(of: Half.self)
+  print("Decoder output: \(decoded.shape)")
+  let result = Tensor<Float>(from: decoded.rawValue.toCPU())
+  print(
+    "decoded vs PyTorch: relative error "
+      + String(format: "%.5f", relativeError(result, referenceTensor("decoded"), [size, size, 4])))
+  for (channel, label) in ["red", "green", "blue", "alpha"].enumerated() {
+    var squareError = 0.0
+    for y in 0..<size {
+      for x in 0..<size {
+        // Back to 0...1 as a picture, clamped like the output is.
+        if channel < 3 && Float(image[0, y, x, 3]) <= 0 { continue }  // colour under transparency
+        let expected = (Double(image[0, y, x, channel]) + 1) / 2
+        let actual = min(max((Double(result[0, y, x, channel]) + 1) / 2, 0), 1)
+        squareError += (expected - actual) * (expected - actual)
+      }
+    }
+    let mse = squareError / Double(size * size)  // not divided by the opaque count: see below
+    print("\(label): PSNR \(String(format: "%.1f", 10 * log10(1 / max(mse, 1e-12)))) dB")
+  }
+}
