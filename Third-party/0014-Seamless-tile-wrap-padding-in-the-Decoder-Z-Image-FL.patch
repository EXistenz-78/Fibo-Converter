diff --git a/Libraries/SwiftDiffusion/Sources/SeamlessTile.swift b/Libraries/SwiftDiffusion/Sources/SeamlessTile.swift
index 30239e9..0565e10 100644
--- a/Libraries/SwiftDiffusion/Sources/SeamlessTile.swift
+++ b/Libraries/SwiftDiffusion/Sources/SeamlessTile.swift
@@ -1,4 +1,5 @@
 import Foundation
+import NNC
 
 /// Seamless tile: the image repeats with no edge along the axes it wraps. The request carries it as
 /// `GenerationConfiguration.seamlessTile` (0 off, 1 left-right, 2 up-down, 3 both).
@@ -53,3 +54,80 @@ public func torusAngle(position: Double, omega: Double, period: Double, minTurns
   if wrapped < 0 { wrapped += period }
   return wrapped * torusFrequency(omega: omega, period: period, minTurns: minTurns)
 }
+
+/// Circular padding in NHWC: the last `top` rows go above the first and the first `top` rows below
+/// the last (and the same with `left` for the columns), only on the axes that wrap. The input is
+/// `batchSize`x`height`x`width`x`channels`; the output grows by `2 * top` rows and `2 * left`
+/// columns on the wrapped axes. Slices need the shape, so the caller gives it.
+public func WrapPad(
+  batchSize: Int, height: Int, width: Int, channels: Int, top: Int, left: Int,
+  wrapsHeight: Bool, wrapsWidth: Bool
+) -> Model {
+  let x = Input()
+  var out: Model.IO = x
+  var height = height
+  if wrapsHeight && top > 0 {
+    precondition(top <= height, "WrapPad: \(top) rows from a height of \(height)")
+    let strides: TensorShape = [height * width * channels, width * channels, channels, 1]
+    let last = out.reshaped(
+      [batchSize, top, width, channels], offset: [0, height - top, 0, 0], strides: strides
+    ).contiguous()
+    let first = out.reshaped(
+      [batchSize, top, width, channels], offset: [0, 0, 0, 0], strides: strides
+    ).contiguous()
+    out = Functional.concat(axis: 1, last, out, first)
+    height += 2 * top
+  }
+  if wrapsWidth && left > 0 {
+    precondition(left <= width, "WrapPad: \(left) columns from a width of \(width)")
+    let strides: TensorShape = [height * width * channels, width * channels, channels, 1]
+    let last = out.reshaped(
+      [batchSize, height, left, channels], offset: [0, 0, width - left, 0], strides: strides
+    ).contiguous()
+    let first = out.reshaped(
+      [batchSize, height, left, channels], offset: [0, 0, 0, 0], strides: strides
+    ).contiguous()
+    out = Functional.concat(axis: 2, last, out, first)
+  }
+  return Model([x], [out])
+}
+
+/// A stride-1 convolution on an NHWC input of `inputShape` that pads circularly on the axes `wrap`
+/// wraps. With `wrap == nil` it is exactly `Convolution(..., hint: Hint(stride: [1, 1], border:
+/// border), ...)`, so the weights keep their names. Otherwise the input goes through `WrapPad` by
+/// the border on each wrapped axis (begin and end must match there) and the convolution's border
+/// on that axis becomes 0; the other axis keeps its border. Returns the convolution (for its
+/// weights) and the function that applies it.
+public func WrappingConvolution(
+  groups: Int, filters: Int, filterSize: [Int], border: Hint.Border, wrap: SeamlessTile?,
+  inputShape: (batchSize: Int, height: Int, width: Int, channels: Int),
+  format: Convolution.Format, name: String = ""
+) -> (Convolution, (Model.IO) -> Model.IO) {
+  guard let wrap = wrap else {
+    let conv = Convolution(
+      groups: groups, filters: filters, filterSize: filterSize,
+      hint: Hint(stride: [1, 1], border: border), format: format, name: name)
+    return (conv, { conv($0) })
+  }
+  let begin = border.begin.count == 2 ? border.begin : [0, 0]
+  let end = border.end.count == 2 ? border.end : [0, 0]
+  let wrapsHeight = wrap.wrapsHeight && (begin[0] > 0 || end[0] > 0)
+  let wrapsWidth = wrap.wrapsWidth && (begin[1] > 0 || end[1] > 0)
+  precondition(!wrapsHeight || begin[0] == end[0], "WrappingConvolution: uneven height border")
+  precondition(!wrapsWidth || begin[1] == end[1], "WrappingConvolution: uneven width border")
+  let conv = Convolution(
+    groups: groups, filters: filters, filterSize: filterSize,
+    hint: Hint(
+      stride: [1, 1],
+      border: Hint.Border(
+        begin: [wrapsHeight ? 0 : begin[0], wrapsWidth ? 0 : begin[1]],
+        end: [wrapsHeight ? 0 : end[0], wrapsWidth ? 0 : end[1]])), format: format, name: name)
+  guard wrapsHeight || wrapsWidth else {
+    return (conv, { conv($0) })
+  }
+  let pad = WrapPad(
+    batchSize: inputShape.batchSize, height: inputShape.height, width: inputShape.width,
