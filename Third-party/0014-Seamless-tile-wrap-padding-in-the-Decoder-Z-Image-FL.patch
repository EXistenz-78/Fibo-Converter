diff --git a/Apps/SeamlessTileTest/main.swift b/Apps/SeamlessTileTest/main.swift
index 3fb839d..bbd9ed4 100644
--- a/Apps/SeamlessTileTest/main.swift
+++ b/Apps/SeamlessTileTest/main.swift
@@ -299,6 +299,219 @@ do {
   checkTorus(layout, off: f3(nil), both: f3(both), widthOnly: f3(widthOnly))
 }
 
+// MARK: Wrap padding in the VAE decoder.
+
+let wrapGraph = DynamicGraph()
+
+// The graphs run on the GPU: the CPU reference convolution does not take OIHW weights with NHWC
+// inputs, which is what the decoder uses.
+func runModel(_ model: Model, _ input: Tensor<Float>) -> Tensor<Float> {
+  return wrapGraph.withNoGrad {
+    let x = wrapGraph.variable(input.toGPU(0))
+    return model(inputs: x)[0].as(of: Float.self).rawValue.toCPU()
+  }
+}
+
+func randomTensor(_ shape: [Int]) -> Tensor<Float> {
+  var t = Tensor<Float>(.CPU, .NHWC(shape[0], shape[1], shape[2], shape[3]))
+  for n in 0..<shape[0] {
+    for y in 0..<shape[1] {
+      for x in 0..<shape[2] {
+        for c in 0..<shape[3] { t[n, y, x, c] = Float.random(in: -1...1) }
+      }
+    }
+  }
+  return t
+}
+
+/// The input repeated `rows` times down and `columns` times across (NHWC).
+func tiled(_ t: Tensor<Float>, rows: Int, columns: Int) -> Tensor<Float> {
+  let (n, h, w, c) = (t.shape[0], t.shape[1], t.shape[2], t.shape[3])
+  var out = Tensor<Float>(.CPU, .NHWC(n, h * rows, w * columns, c))
+  for b in 0..<n {
+    for y in 0..<(h * rows) {
+      for x in 0..<(w * columns) {
+        for k in 0..<c { out[b, y, x, k] = t[b, y % h, x % w, k] }
+      }
+    }
+  }
+  return out
+}
+
+/// The largest absolute difference between `a` and the window of `b` at (`top`, `left`).
+func maxDifference(_ a: Tensor<Float>, _ b: Tensor<Float>, top: Int, left: Int) -> Float {
+  var worst: Float = 0
+  for n in 0..<a.shape[0] {
+    for y in 0..<a.shape[1] {
+      for x in 0..<a.shape[2] {
+        for c in 0..<a.shape[3] {
+          worst = max(worst, abs(a[n, y, x, c] - b[n, y + top, x + left, c]))
+        }
+      }
+    }
+  }
+  return worst
+}
+
+// WrapPad on a known 1x4x5x1 tensor: the opposite edges come around.
+do {
+  var known = Tensor<Float>(.CPU, .NHWC(1, 4, 5, 1))
+  for y in 0..<4 {
+    for x in 0..<5 { known[0, y, x, 0] = Float(y * 10 + x) }
+  }
+  let both = runModel(
+    WrapPad(
+      batchSize: 1, height: 4, width: 5, channels: 1, top: 1, left: 1, wrapsHeight: true,
+      wrapsWidth: true), known)
+  check(both.shape[1] == 6 && both.shape[2] == 7, "WrapPad both gives 1x6x7x1")
+  for y in 0..<6 {
+    for x in 0..<7 {
+      let expected = Float(((y + 3) % 4) * 10 + (x + 4) % 5)
+      check(both[0, y, x, 0] == expected, "WrapPad both at \(y), \(x)")
+    }
+  }
+  let heightOnly = runModel(
+    WrapPad(
+      batchSize: 1, height: 4, width: 5, channels: 1, top: 1, left: 1, wrapsHeight: true,
+      wrapsWidth: false), known)
+  check(heightOnly.shape[1] == 6 && heightOnly.shape[2] == 5, "WrapPad height gives 1x6x5x1")
+  for y in 0..<6 {
+    for x in 0..<5 {
+      check(
+        heightOnly[0, y, x, 0] == Float(((y + 3) % 4) * 10 + x), "WrapPad height at \(y), \(x)")
+    }
+  }
+}
+
+// A wrapping 3x3 convolution equals the same convolution on the 3x3 tile, cropped to the center.
+// The other axis keeps its zero border.
+do {
+  let input = randomTensor([1, 8, 8, 4])
+  var weight = Tensor<Float>(.CPU, .NCHW(3, 4, 3, 3))
+  for o in 0..<3 {
+    for i in 0..<4 {
+      for y in 0..<3 {
+        for x in 0..<3 { weight[o, i, y, x] = Float.random(in: -1...1) }
+      }
+    }
+  }
+  var bias = Tensor<Float>(.CPU, .C(3))
+  for o in 0..<3 { bias[o] = Float.random(in: -1...1) }
+  let border = Hint.Border(begin: [1, 1], end: [1, 1])
+  for (value, rows, columns) in [(Int8(3), 3, 3), (Int8(2), 3, 1), (Int8(1), 1, 3)] {
+    let wrap = SeamlessTile(configurationValue: value)!
+    let (conv, apply) = WrappingConvolution(
+      groups: 1, filters: 3, filterSize: [3, 3], border: border, wrap: wrap,
+      inputShape: (batchSize: 1, height: 8, width: 8, channels: 4), format: .OIHW)
+    let x = Input()
+    let wrapping = Model([x], [apply(x)])
+    wrapGraph.withNoGrad {
+      wrapping.compile(inputs: wrapGraph.variable(input.toGPU(0)))
+    }
+    conv.weight.copy(from: weight)
+    conv.bias.copy(from: bias)
+    let reference = Convolution(
+      groups: 1, filters: 3, filterSize: [3, 3], hint: Hint(stride: [1, 1], border: border),
+      format: .OIHW)
+    let tile = tiled(input, rows: rows, columns: columns)
+    wrapGraph.withNoGrad {
+      reference.compile(inputs: wrapGraph.variable(tile.toGPU(0)))
+    }
+    reference.weight.copy(from: weight)
+    reference.bias.copy(from: bias)
+    let out = runModel(wrapping, input)
+    let expected = runModel(reference, tile)
+    check(out.shape[1] == 8 && out.shape[2] == 8, "wrapping conv \(value) keeps 8x8")
+    let difference = maxDifference(
+      out, expected, top: rows == 3 ? 8 : 0, left: columns == 3 ? 8 : 0)
+    check(difference < 1e-4, "wrapping conv \(value) matches the tile (\(difference))")
+  }
+}
+
+/// The input moved by `dy` rows and `dx` columns, wrapping around (NHWC).
+func rolled(_ t: Tensor<Float>, _ dy: Int, _ dx: Int) -> Tensor<Float> {
+  let (n, h, w, c) = (t.shape[0], t.shape[1], t.shape[2], t.shape[3])
+  var out = Tensor<Float>(.CPU, .NHWC(n, h, w, c))
+  for b in 0..<n {
+    for y in 0..<h {
+      for x in 0..<w {
+        for k in 0..<c { out[b, (y + dy) % h, (x + dx) % w, k] = t[b, y, x, k] }
+      }
+    }
+  }
+  return out
+}
+
+// The Decoder with wrap reads the same weights as without (same parameter names, the plain one
+// reads the wrapping one's file strictly). A wrapping decoder commutes with a circular shift on
+// its wrapped axes: group norm and attention don't see positions and every padded convolution
+// is circular, so moving the latent by (1, 1) moves the picture by (2, 2) with one upsampling.
+// The plain decoder does not (its zero borders break the shift), which shows the check bites.
+// (Comparing with the plain decoder on a tiled latent can't work: the mid attention is global
+// and the receptive field is wider than one tile.)
+func decoderKeys(_ model: Model, _ path: String) -> [String] {
+  var keys = [String]()
+  wrapGraph.openStore(path) { store in
+    store.write("decoder", model: model)
+    keys = store.keys.sorted()
+  }
+  return keys
+}
+for (specializingNames, value) in [(false, Int8(3)), (true, Int8(3)), (true, Int8(1))] {
+  let wrap = SeamlessTile(configurationValue: value)!
+  func makeDecoder(wrap: SeamlessTile?) -> Model {
+    return Decoder(
+      channels: [32, 32], numRepeat: 1, batchSize: 1, startWidth: 4, startHeight: 4,
+      inputChannels: 16, highPrecisionKeysAndValues: false, usesFlashAttention: false,
+      paddingFinalConvLayer: true, format: .NHWC, quantLayer: true,
+      specializingNames: specializingNames, wrap: wrap
+    ).0
+  }
+  let latent = randomTensor([1, 4, 4, 16])
+  let dy = wrap.wrapsHeight ? 1 : 0
+  let dx = wrap.wrapsWidth ? 1 : 0
+  let wrapping = makeDecoder(wrap: wrap)
+  let plain = makeDecoder(wrap: nil)
+  // The parameters exist once a model has run.
+  let out = runModel(wrapping, latent)
+  _ = runModel(plain, latent)
+  let directory = FileManager.default.temporaryDirectory
+  let wrapPath = directory.appendingPathComponent("seamless-\(UUID().uuidString).ckpt").path
+  let plainPath = directory.appendingPathComponent("seamless-\(UUID().uuidString).ckpt").path
+  defer {
+    try? FileManager.default.removeItem(atPath: wrapPath)
+    try? FileManager.default.removeItem(atPath: plainPath)
+  }
+  let wrapKeys = decoderKeys(wrapping, wrapPath)
+  let plainKeys = decoderKeys(plain, plainPath)
+  check(
+    !wrapKeys.isEmpty && wrapKeys == plainKeys,
+    "Decoder parameter names (specializingNames \(specializingNames)) are the same with wrap")
+  var readError: Error? = nil
+  wrapGraph.openStore(wrapPath, flags: .readOnly) { store in
+    do {
+      try store.read("decoder", model: plain, strict: true)
+    } catch {
+      readError = error
+    }
+  }
+  check(readError == nil, "the plain Decoder reads the wrapping Decoder's weights")
+  check(out.shape[1] == 8 && out.shape[2] == 8 && out.shape[3] == 4, "Decoder output 1x8x8x4")
+  let shifted = runModel(wrapping, rolled(latent, dy, dx))
+  let difference = maxDifference(rolled(out, 2 * dy, 2 * dx), shifted, top: 0, left: 0)
+  check(
+    difference < 1e-3,
+    "Decoder with wrap \(value) (specializingNames \(specializingNames)) commutes with the shift"
+      + " (\(difference))")
+  let plainOut = runModel(plain, latent)
+  let plainShifted = runModel(plain, rolled(latent, dy, dx))
+  let plainDifference = maxDifference(
+    rolled(plainOut, 2 * dy, 2 * dx), plainShifted, top: 0, left: 0)
+  check(
+    plainDifference > 1e-2,
+    "the plain Decoder does not commute with the shift (\(plainDifference))")
+}
+
 print("SeamlessTileTest: all passed")
 
