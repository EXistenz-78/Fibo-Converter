+  /// Ming-Image's conditioning: the Ling language model over the chat prompt followed by the 256
+  /// learnable-query tokens (one layer at a time, the host picks each MoE layer's experts), then
+  /// the Qwen2 connector over the queries' outputs and the directvlm projection over the prompt's.
+  /// Returns `[queries [1, 256, 2560], tokens [1, prompt length, 3840]]`. The token ids hold the
+  /// whole prompt, `<image>`, 256 `<imagePatch>` and `</image>`; there is no unconditional half.
+  private func encodeMingImage(
+    images: [DynamicGraph.Tensor<FloatType>], tokens: [DynamicGraph.Tensor<Int32>],
+    tokenLengthUncond: inout Int, tokenLengthCond: inout Int
+  ) -> ([DynamicGraph.Tensor<FloatType>], [Model]) {
+    let graph = tokens[0].graph
+    let configuration = MingLingConfiguration.ming
+    let connectorConfiguration = MingConnectorConfiguration.ming
+    let externalData: DynamicGraph.Store.Codec =
+      externalOnDemand || deviceProperties.memoryCapacity < .high
+      ? .externalOnDemand : .externalData(deviceProperties.isFreadPreferred ? .fread : .mmap)
+    let codec: DynamicGraph.Store.Codec = [.q8p, .q6p, .q4p, .ezm7, .i8x, .jit, externalData]
+    let encoderPath = filePaths[0]
+    let patchToken: Int32 = 157_157
+    let imageStartToken: Int32 = 157_158
+    let imageEndToken: Int32 = 157_159
+    let half = tokens[0].shape[0] / 2
+    let idsTensor = tokens[0].rawValue.toCPU()
+    var ids = (0..<tokenLengthCond).map { idsTensor[half + $0] }
+    // Reference pictures (editing) go through the vision tower. The prompt carries one
+    // <image><imagePatch></image> per picture in the user's turn, widened here to one
+    // <imagePatch> per merged vision token.
+    var imageGrids = [(rows: Int, columns: Int)]()
+    var imageFeatures = [Tensor<Float>]()
+    guard let queryStart = ids.lastIndex(of: imageStartToken) else {
+      fatalError("Ming Image: the prompt has no <image> token")
+    }
+    if !images.isEmpty, filePaths.count > 1 {
+      let visionPath = filePaths[1]
+      var expanded = [Int32]()
+      var next = 0
+      var index = 0
+      while index < queryStart {
+        if ids[index] == imageStartToken, index + 2 < queryStart, ids[index + 1] == patchToken,
+          ids[index + 2] == imageEndToken, next < images.count
+        {
+          let picture = images[next]
+          next += 1
+          let shape = picture.shape
+          let rgb = DynamicGraph.Tensor<Float16>(
+            from: picture[0..<1, 0..<shape[1], 0..<shape[2], 0..<3].copied())
+          let (patches, gridX, gridY) = MingVisionPatches(image: rgb, graph: graph)
+          // The tower overflows in half precision, it runs in single.
+          let vit = MingVisionTransformer(gridX: gridX, gridY: gridY, usesFlashAttention: false)
+          let patches32 = DynamicGraph.Tensor<Float>(from: patches)
+          let rot = graph.variable(
+            MingVisionRotaryEmbedding(gridX: gridX, gridY: gridY, of: Float.self).toGPU(0))
+          vit.compile(inputs: patches32, rot)
+          graph.openStore(visionPath, flags: .readOnly) { store in
+            store.read("vit", model: vit, codec: codec)
+          }
+          let merged = vit(inputs: patches32, rot)[0].as(of: Float.self)
+          let ordered = MingVisionUnshuffle(
+            DynamicGraph.Tensor<Float16>(from: merged), gridX: gridX, gridY: gridY, graph: graph)
+          let projection = MingImageProjection(Float16.self)
+          projection.compile(inputs: ordered)
+          graph.openStore(visionPath, flags: .readOnly) { store in
+            store.read("vit", model: projection, codec: codec)
+          }
+          let features = projection(inputs: ordered)[0].as(of: Float.self).rawValue.toCPU()
+          expanded.append(imageStartToken)
+          expanded.append(contentsOf: [Int32](repeating: patchToken, count: features.shape[0]))
+          expanded.append(imageEndToken)
+          imageGrids.append((rows: gridY / 2, columns: gridX / 2))
+          imageFeatures.append(features)
+          index += 3
+        } else {
+          expanded.append(ids[index])
+          index += 1
+        }
+      }
+      ids = expanded + Array(ids[queryStart...])
+    }
+    let tokenLength = ids.count
+    let isPatch = ids.map { $0 == patchToken }
+    let promptLength = ids.lastIndex(of: imageStartToken)!
+    let patchIndices = (0..<tokenLength).filter { isPatch[$0] }
+    let queryCount = 256
+    precondition(
+      patchIndices.count == queryCount + imageFeatures.reduce(0) { $0 + $1.shape[0] },
+      "Ming Image expects 256 learnable query tokens")
+    tokenLengthUncond = tokenLength
+    // 3D rotary positions: the text counts up, each picture and the 256 queries are blocks that
+    // share the time position and spread over the height and width around it.
+    var positions = [[Int]](repeating: [Int](repeating: 0, count: tokenLength), count: 3)
+    var blocks = [(first: Int, rows: Int, columns: Int)]()
+    var patchCursor = 0
+    for (k, grid) in imageGrids.enumerated() {
+      blocks.append((patchIndices[patchCursor], grid.rows, grid.columns))
+      patchCursor += imageFeatures[k].shape[0]
+    }
+    blocks.append((patchIndices[patchCursor], 1, queryCount))
+    var cursor = 0
+    var nextPosition = 0
+    for block in blocks {
+      let textLength = block.first - cursor
+      for i in 0..<textLength {
+        for row in 0..<3 { positions[row][cursor + i] = nextPosition + i }
+      }
+      let base = nextPosition + textLength
+      for r in 0..<block.rows {
+        for c in 0..<block.columns {
+          let i = block.first + r * block.columns + c
+          positions[0][i] = base
+          positions[1][i] = r - (block.rows - 1) / 2 + base
+          positions[2][i] = c - (block.columns - 1) / 2 + base
+        }
+      }
+      cursor = block.first + block.rows * block.columns
