+/// Ming-Image's tokenizer, read from the tokenizer file next to the model on first use.
+final class MingTokenizerCache {
+  private let lock = NSLock()
+  private var path: String? = nil
+  private var cached: TiktokenTokenizer? = nil
+  func tokenizer(at path: String) -> TiktokenTokenizer? {
+    lock.lock()
+    defer { lock.unlock() }
+    if self.path == path, let cached { return cached }
+    guard let data = try? Data(contentsOf: URL(fileURLWithPath: path)),
+      let tokenizer = try? TiktokenTokenizer(
+        huggingFaceTokenizerJSON: data, pretokenizer: .ling, unknownToken: "<|endoftext|>",
+        startToken: "<|endoftext|>", endToken: "<|role_end|>")
+    else { return nil }
+    self.path = path
+    cached = tokenizer
+    return tokenizer
+  }
+}
