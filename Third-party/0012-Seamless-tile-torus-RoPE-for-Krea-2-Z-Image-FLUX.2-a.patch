+// MARK: RoPE on the torus.
+
+let gridH = 8
+let gridW = 12
+let textLen = 7
+
+func sameFloats<T: TensorNumeric & BinaryFloatingPoint>(
+  _ a: Tensor<T>, _ b: Tensor<T>, _ message: String
+) {
+  check(a.shape[0] == b.shape[0] && a.shape[1] == b.shape[1], "\(message): same token count")
+  check(a.shape[2] == b.shape[2] && a.shape[3] == b.shape[3], "\(message): same shape")
+  for t in 0..<a.shape[1] {
+    for h in 0..<a.shape[2] {
+      for c in 0..<a.shape[3] {
+        if a[0, t, h, c] != b[0, t, h, c] {
+          print("FAIL: \(message) differs at token \(t) head \(h) channel \(c)")
+          exit(1)
+        }
+      }
+    }
+  }
+}
+
+/// Layout of one function's output: where the height and width pairs sit and how many leading
+/// tokens are image tokens (laid out as y * gridW + x).
+struct RopeLayout {
+  var name: String
+  var heads: Int
+  var heightPairs: Range<Int>
+  var widthPairs: Range<Int>
+  var imageTokens: Int
+}
+
+func angle(_ t: Tensor<Float>, _ token: Int, _ head: Int, _ pair: Int) -> Double {
+  return atan2(Double(t[0, token, head, pair * 2 + 1]), Double(t[0, token, head, pair * 2]))
+}
+
+/// The step between two neighbours times the period is a whole number of turns.
+func checkPeriodic(
+  _ t: Tensor<Float>, _ layout: RopeLayout, axisIsWidth: Bool
+) {
+  let pairs = axisIsWidth ? layout.widthPairs : layout.heightPairs
+  let period = Double(axisIsWidth ? gridW : gridH)
+  var movingChannels = 0
+  for head in 0..<layout.heads {
+    for pair in pairs {
+      // Several rows (columns) to be sure it is the same for every one of them.
+      for line in 0..<(axisIsWidth ? gridH : gridW) {
+        let t0 = axisIsWidth ? line * gridW : line
+        let t1 = axisIsWidth ? line * gridW + 1 : gridW + line
+        var step = angle(t, t1, head, pair) - angle(t, t0, head, pair)
+        step -= (step / (2 * Double.pi)).rounded() * 2 * Double.pi
+        let total = step * period
+        let turns = (total / (2 * Double.pi)).rounded()
+        check(
+          abs(total - turns * 2 * Double.pi) < 1e-5,
+          "\(layout.name): \(axisIsWidth ? "width" : "height") pair \(pair) is not periodic")
+        if line == 0 && head == 0 && abs(step) > 1e-9 { movingChannels += 1 }
+      }
+    }
+  }
+  check(movingChannels > 0, "\(layout.name): some channel of the axis still turns")
+}
+
+func checkTorus(
+  _ layout: RopeLayout, off: Tensor<Float>, both: Tensor<Float>, widthOnly: Tensor<Float>
+) {
+  check(off.shape[1] == both.shape[1], "\(layout.name): same token count")
+  checkPeriodic(both, layout, axisIsWidth: true)
+  checkPeriodic(both, layout, axisIsWidth: false)
+  // Everything but the height and width channels of the image tokens is the same as without.
+  for t in 0..<off.shape[1] {
+    for h in 0..<off.shape[2] {
+      for c in 0..<off.shape[3] {
+        let pair = c / 2
+        let isAxis =
+          t < layout.imageTokens
+          && (layout.heightPairs.contains(pair) || layout.widthPairs.contains(pair))
+        if !isAxis {
+          check(
+            both[0, t, h, c] == off[0, t, h, c] && widthOnly[0, t, h, c] == off[0, t, h, c],
+            "\(layout.name): token \(t) channel \(c) is unchanged")
+        }
+        // Width only: the height channels are the same as without.
+        if t < layout.imageTokens && layout.heightPairs.contains(pair) {
+          check(
+            widthOnly[0, t, h, c] == off[0, t, h, c],
+            "\(layout.name): width only leaves the height channel \(c) alone")
+        }
+      }
+    }
+  }
+  // The torus really changed something.
+  var changed = false
+  for t in 0..<layout.imageTokens {
+    for c in 0..<off.shape[3] where both[0, t, 0, c] != off[0, t, 0, c] { changed = true }
+  }
+  check(changed, "\(layout.name): the torus changes the image tokens")
+}
+
+let both = SeamlessTile(configurationValue: 3)
+let widthOnly = SeamlessTile(configurationValue: 1)
+let heightOnly = SeamlessTile(configurationValue: 2)
+
+// Krea 2 (Float16 and Float, as the call sites use FloatType).
+for references in [0, 1] {
+  sameFloats(
+    Krea2RotaryPositionEmbedding(
+      textLength: textLen, gridHeight: gridH, gridWidth: gridW, referenceCount: references,
+      of: Float.self, seamless: nil),
+    referenceKrea2Rope(
+      textLength: textLen, gridHeight: gridH, gridWidth: gridW, referenceCount: references,
+      of: Float.self),
+    "Krea 2 nil (Float, \(references) references)")
+  sameFloats(
+    Krea2RotaryPositionEmbedding(
+      textLength: textLen, gridHeight: gridH, gridWidth: gridW, referenceCount: references,
+      of: Float16.self, seamless: nil),
+    referenceKrea2Rope(
+      textLength: textLen, gridHeight: gridH, gridWidth: gridW, referenceCount: references,
+      of: Float16.self),
+    "Krea 2 nil (Float16, \(references) references)")
+}
+do {
+  func krea(_ s: SeamlessTile?, _ references: Int) -> Tensor<Float> {
+    return Krea2RotaryPositionEmbedding(
+      textLength: textLen, gridHeight: gridH, gridWidth: gridW, referenceCount: references,
+      of: Float.self, seamless: s)
+  }
+  let layout = RopeLayout(
+    name: "Krea 2", heads: 1, heightPairs: 16..<40, widthPairs: 40..<64,
+    imageTokens: gridH * gridW)
+  checkTorus(
+    layout, off: krea(nil, 0), both: krea(both, 0), widthOnly: krea(widthOnly, 0))
+  let heightTensor = krea(heightOnly, 0)
+  let offTensor = krea(nil, 0)
+  for t in 0..<(gridH * gridW) {
+    for c in (40 * 2)..<(64 * 2) {
+      check(heightTensor[0, t, 0, c] == offTensor[0, t, 0, c], "Krea 2 height only keeps width")
+    }
+  }
+  // One reference: its tokens carry the same y / x angles as the image tokens.
+  let withReference = krea(both, 1)
+  let imageCount = gridH * gridW
+  for t in 0..<imageCount {
+    for c in (16 * 2)..<(64 * 2) {
+      check(
+        withReference[0, t, 0, c] == withReference[0, t + imageCount, 0, c],
+        "Krea 2 reference token \(t) channel \(c) has the image angles")
+    }
+  }
+  // The frame axis and the text are as without.
+  let withReferenceOff = krea(nil, 1)
+  for t in 0..<withReference.shape[1] {
+    for c in 0..<(16 * 2) {
+      check(withReference[0, t, 0, c] == withReferenceOff[0, t, 0, c], "Krea 2 frame axis")
+    }
+    if t >= 2 * imageCount {
+      for c in 0..<(64 * 2) {
+        check(withReference[0, t, 0, c] == withReferenceOff[0, t, 0, c], "Krea 2 text row")
+      }
+    }
+  }
+}
+
+// Z-Image.
+for references in [0, 1] {
+  sameFloats(
+    ZImageRotaryPositionEmbedding(
+      height: gridH, width: gridW, tokenLength: textLen, imagePaddedLength: 3, heads: 2,
+      referenceFrames: references, seamless: nil),
+    referenceZImageRope(
+      height: gridH, width: gridW, tokenLength: textLen, imagePaddedLength: 3, heads: 2,
+      referenceFrames: references),
+    "Z-Image nil (\(references) reference frames)")
+}
+sameFloats(
+  ZImageRotaryPositionEmbedding(
+    height: 0, width: 0, tokenLength: 32, imagePaddedLength: 0, seamless: nil),
+  referenceZImageRope(height: 0, width: 0, tokenLength: 32, imagePaddedLength: 0),
+  "Z-Image nil (text only)")
+do {
+  func z(_ s: SeamlessTile?) -> Tensor<Float> {
+    return ZImageRotaryPositionEmbedding(
+      height: gridH, width: gridW, tokenLength: textLen, imagePaddedLength: 3, heads: 2,
+      seamless: s)
+  }
+  let layout = RopeLayout(
+    name: "Z-Image", heads: 2, heightPairs: 16..<40, widthPairs: 40..<64,
+    imageTokens: gridH * gridW)
+  checkTorus(layout, off: z(nil), both: z(both), widthOnly: z(widthOnly))
+}
+
+// FLUX.2.
+let flux2References = [(height: 4, width: 6)]
+sameFloats(
+  Flux2RotaryPositionEmbedding(
+    height: gridH, width: gridW, tokenLength: textLen, referenceSizes: flux2References,
+    channels: 128, heads: 2, seamless: nil),
+  referenceFlux2Rope(
+    height: gridH, width: gridW, tokenLength: textLen, referenceSizes: flux2References,
+    channels: 128, heads: 2),
+  "FLUX.2 nil")
+do {
+  func f2(_ s: SeamlessTile?) -> Tensor<Float> {
+    return Flux2RotaryPositionEmbedding(
+      height: gridH, width: gridW, tokenLength: textLen, referenceSizes: flux2References,
+      channels: 128, heads: 2, seamless: s)
+  }
+  let layout = RopeLayout(
+    name: "FLUX.2", heads: 2, heightPairs: 16..<32, widthPairs: 32..<48,
+    imageTokens: gridH * gridW)
+  checkTorus(layout, off: f2(nil), both: f2(both), widthOnly: f2(widthOnly))
+}
+
+// FLUX.3 (positions are y * 0.5 and x * 0.5, so the period is the grid * 0.5).
+sameFloats(
+  Flux3RotaryPositionEmbedding(
+    height: gridH, width: gridW, tokenLength: textLen, referenceSizes: flux2References,
+    channels: 128, heads: 2, seamless: nil),
+  referenceFlux3Rope(
+    height: gridH, width: gridW, tokenLength: textLen, referenceSizes: flux2References,
+    channels: 128, heads: 2),
+  "FLUX.3 nil")
+do {
+  func f3(_ s: SeamlessTile?) -> Tensor<Float> {
+    return Flux3RotaryPositionEmbedding(
+      height: gridH, width: gridW, tokenLength: textLen, referenceSizes: flux2References,
+      channels: 128, heads: 2, seamless: s)
+  }
+  let layout = RopeLayout(
+    name: "FLUX.3", heads: 2, heightPairs: 16..<32, widthPairs: 32..<48,
+    imageTokens: gridH * gridW)
+  checkTorus(layout, off: f3(nil), both: f3(both), widthOnly: f3(widthOnly))
+}
+
 print("SeamlessTileTest: all passed")
