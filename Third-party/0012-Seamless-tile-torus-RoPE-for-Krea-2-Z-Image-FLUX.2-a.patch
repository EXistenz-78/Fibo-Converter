+// MARK: Frozen copies of the formulas as they were before the seamless parameter.
+
+func referenceKrea2Rope<FloatType: TensorNumeric & BinaryFloatingPoint>(
+  textLength: Int, gridHeight: Int, gridWidth: Int, referenceCount: Int = 0,
+  of dataType: FloatType.Type = FloatType.self
+) -> Tensor<FloatType> {
+  let ropeTheta: Double = 1_000
+  let imageLength = gridHeight * gridWidth
+  // Layout is [image | references | text]. Each reference has the same grid as the image and sits
+  // at the same (y, x); only its first axis (frame) differs: 0 for the image, i + 1 for reference i.
+  let tokenLength = imageLength * (1 + referenceCount) + textLength
+  var rotary = Tensor<FloatType>(.CPU, .NHWC(1, tokenLength, 1, 128))
+  let dim0 = 32
+  let dim1 = 48
+  let dim2 = 48
+  for frame in 0...referenceCount {
+   for y in 0..<gridHeight {
+    for x in 0..<gridWidth {
+      let i = frame * imageLength + y * gridWidth + x
+      for k in 0..<(dim0 / 2) {
+        let theta = Double(frame) * 1.0 / pow(ropeTheta, Double(k) * 2 / Double(dim0))
+        let sintheta = sin(theta)
+        let costheta = cos(theta)
+        rotary[0, i, 0, k * 2] = FloatType(costheta)
+        rotary[0, i, 0, k * 2 + 1] = FloatType(sintheta)
+      }
+      for k in 0..<(dim1 / 2) {
+        let theta = Double(y) * 1.0 / pow(ropeTheta, Double(k) * 2 / Double(dim1))
+        let sintheta = sin(theta)
+        let costheta = cos(theta)
+        rotary[0, i, 0, (k + (dim0 / 2)) * 2] = FloatType(costheta)
+        rotary[0, i, 0, (k + (dim0 / 2)) * 2 + 1] = FloatType(sintheta)
+      }
+      for k in 0..<(dim2 / 2) {
+        let theta = Double(x) * 1.0 / pow(ropeTheta, Double(k) * 2 / Double(dim2))
+        let sintheta = sin(theta)
+        let costheta = cos(theta)
+        rotary[0, i, 0, (k + (dim0 / 2) + (dim1 / 2)) * 2] = FloatType(costheta)
+        rotary[0, i, 0, (k + (dim0 / 2) + (dim1 / 2)) * 2 + 1] = FloatType(sintheta)
+      }
+    }
+   }
+  }
+  let tokenOffset = imageLength * (1 + referenceCount)
+  for i in 0..<textLength {
+    for k in 0..<(dim0 / 2) {
+      let theta = 0 * 1.0 / pow(ropeTheta, Double(k) * 2 / Double(dim0))
+      let sintheta = sin(theta)
+      let costheta = cos(theta)
+      rotary[0, i + tokenOffset, 0, k * 2] = FloatType(costheta)
+      rotary[0, i + tokenOffset, 0, k * 2 + 1] = FloatType(sintheta)
+    }
+    for k in 0..<(dim1 / 2) {
+      let theta = 0 * 1.0 / pow(ropeTheta, Double(k) * 2 / Double(dim1))
+      let sintheta = sin(theta)
+      let costheta = cos(theta)
+      rotary[0, i + tokenOffset, 0, (k + (dim0 / 2)) * 2] = FloatType(costheta)
+      rotary[0, i + tokenOffset, 0, (k + (dim0 / 2)) * 2 + 1] = FloatType(sintheta)
+    }
+    for k in 0..<(dim2 / 2) {
+      let theta = 0 * 1.0 / pow(ropeTheta, Double(k) * 2 / Double(dim2))
+      let sintheta = sin(theta)
+      let costheta = cos(theta)
+      rotary[0, i + tokenOffset, 0, (k + (dim0 / 2) + (dim1 / 2)) * 2] = FloatType(costheta)
+      rotary[0, i + tokenOffset, 0, (k + (dim0 / 2) + (dim1 / 2)) * 2 + 1] =
+        FloatType(sintheta)
+    }
+  }
+  return rotary
+}
+
+func referenceZImageRope(
+  height: Int, width: Int, tokenLength: Int, imagePaddedLength: Int, heads: Int = 1,
+  imageTimePosition: Int? = nil, referenceFrames: Int = 0
+) -> Tensor<Float> {
+  // The image's frame comes first, then one frame per reference (Ming-Image): the same (y, x), a
+  // time position one further for each.
+  var rotTensor = Tensor<Float>(
+    .CPU, .NHWC(1, height * width * (1 + referenceFrames) + imagePaddedLength + tokenLength, heads, 128))
+  let dim0 = 32
+  let dim1 = 48
+  let dim2 = 48
+  for frame in 0...referenceFrames {
+    for y in 0..<height {
+      for x in 0..<width {
+        let i = frame * height * width + y * width + x
+        for j in 0..<heads {
+          for k in 0..<(dim0 / 2) {
+            let theta =
+              Double((imageTimePosition ?? tokenLength) + 1 + frame) * 1.0
+              / pow(256, Double(k) * 2 / Double(dim0))
+          let sintheta = sin(theta)
+          let costheta = cos(theta)
+          rotTensor[0, i, j, k * 2] = Float(costheta)
+          rotTensor[0, i, j, k * 2 + 1] = Float(sintheta)
+        }
+        for k in 0..<(dim1 / 2) {
+          let theta =
+            Double(y) * 1.0 / pow(256, Double(k) * 2 / Double(dim1))
+          let sintheta = sin(theta)
+          let costheta = cos(theta)
+          rotTensor[0, i, j, (k + (dim0 / 2)) * 2] = Float(costheta)
+          rotTensor[0, i, j, (k + (dim0 / 2)) * 2 + 1] = Float(sintheta)
+        }
+        for k in 0..<(dim2 / 2) {
+          let theta =
+            Double(x) * 1.0 / pow(256, Double(k) * 2 / Double(dim2))
+          let sintheta = sin(theta)
+          let costheta = cos(theta)
+          rotTensor[0, i, j, (k + (dim0 / 2) + (dim1 / 2)) * 2] = Float(costheta)
+          rotTensor[0, i, j, (k + (dim0 / 2) + (dim1 / 2)) * 2 + 1] = Float(sintheta)
+        }
+      }
+      }
+    }
+  }
+  let imageTokenCount = height * width * (1 + referenceFrames)
+  if imagePaddedLength > 0 {
+    for i in imageTokenCount..<(imageTokenCount + imagePaddedLength) {
+      for j in 0..<heads {
+        for k in 0..<(dim0 / 2) {
+          let theta = Double(0) * 1.0 / pow(256, Double(k) * 2 / Double(dim0))
+          let sintheta = sin(theta)
+          let costheta = cos(theta)
+          rotTensor[0, i, j, k * 2] = Float(costheta)
+          rotTensor[0, i, j, k * 2 + 1] = Float(sintheta)
+        }
+        for k in 0..<(dim1 / 2) {
+          let theta =
+            Double(0) * 1.0 / pow(256, Double(k) * 2 / Double(dim1))
+          let sintheta = sin(theta)
+          let costheta = cos(theta)
+          rotTensor[0, i, j, (k + (dim0 / 2)) * 2] = Float(costheta)
+          rotTensor[0, i, j, (k + (dim0 / 2)) * 2 + 1] = Float(sintheta)
+        }
+        for k in 0..<(dim2 / 2) {
+          let theta =
+            Double(0) * 1.0 / pow(256, Double(k) * 2 / Double(dim2))
+          let sintheta = sin(theta)
+          let costheta = cos(theta)
+          rotTensor[0, i, j, (k + (dim0 / 2) + (dim1 / 2)) * 2] = Float(costheta)
+          rotTensor[0, i, j, (k + (dim0 / 2) + (dim1 / 2)) * 2 + 1] = Float(sintheta)
+        }
+      }
+    }
+  }
+  let offset = imageTokenCount + imagePaddedLength
+  for i in 0..<tokenLength {
+    for j in 0..<heads {
+      for k in 0..<(dim0 / 2) {
+        let theta = Double(i + 1) * 1.0 / pow(256, Double(k) * 2 / Double(dim0))
+        let sintheta = sin(theta)
+        let costheta = cos(theta)
+        rotTensor[0, offset + i, j, k * 2] = Float(costheta)
+        rotTensor[0, offset + i, j, k * 2 + 1] = Float(sintheta)
+      }
+      for k in 0..<(dim1 / 2) {
+        let theta = Double(0) * 1.0 / pow(256, Double(k) * 2 / Double(dim1))
+        let sintheta = sin(theta)
+        let costheta = cos(theta)
+        rotTensor[0, offset + i, j, (k + (dim0 / 2)) * 2] = Float(costheta)
+        rotTensor[0, offset + i, j, (k + (dim0 / 2)) * 2 + 1] = Float(sintheta)
+      }
+      for k in 0..<(dim2 / 2) {
+        let theta = Double(0) * 1.0 / pow(256, Double(k) * 2 / Double(dim2))
+        let sintheta = sin(theta)
+        let costheta = cos(theta)
+        rotTensor[0, offset + i, j, (k + (dim0 / 2) + (dim1 / 2)) * 2] = Float(costheta)
+        rotTensor[0, offset + i, j, (k + (dim0 / 2) + (dim1 / 2)) * 2 + 1] = Float(sintheta)
+      }
+    }
+  }
+  return rotTensor
+}
+
+func referenceFlux2Rope(
+  height: Int, width: Int, tokenLength: Int, referenceSizes: [(height: Int, width: Int)],
+  channels: Int, heads: Int = 1
+)
+  -> Tensor<Float>
+{
+  var rotTensor = Tensor<Float>(
+    .CPU,
+    .NHWC(
+      1, height * width + tokenLength + referenceSizes.reduce(0) { $0 + $1.height * $1.width },
+      heads, channels))
+  let dim0 = channels / 4
+  let dim1 = dim0
+  let dim2 = dim1
+  let dim3 = dim2
+  assert(channels % 16 == 0)
+  for y in 0..<height {
+    for x in 0..<width {
+      let i = y * width + x
+      for j in 0..<heads {
+        for k in 0..<(dim0 / 2) {
+          let theta = 0 * 1.0 / pow(2_000, Double(k) * 2 / Double(dim0))
+          let sintheta = sin(theta)
+          let costheta = cos(theta)
+          rotTensor[0, i, j, k * 2] = Float(costheta)
+          rotTensor[0, i, j, k * 2 + 1] = Float(sintheta)
+        }
+        for k in 0..<(dim1 / 2) {
+          let theta = Double(y) * 1.0 / pow(2_000, Double(k) * 2 / Double(dim1))
+          let sintheta = sin(theta)
+          let costheta = cos(theta)
+          rotTensor[0, i, j, (k + (dim0 / 2)) * 2] = Float(costheta)
+          rotTensor[0, i, j, (k + (dim0 / 2)) * 2 + 1] = Float(sintheta)
+        }
+        for k in 0..<(dim2 / 2) {
+          let theta = Double(x) * 1.0 / pow(2_000, Double(k) * 2 / Double(dim2))
+          let sintheta = sin(theta)
+          let costheta = cos(theta)
+          rotTensor[0, i, j, (k + (dim0 / 2) + (dim1 / 2)) * 2] = Float(costheta)
+          rotTensor[0, i, j, (k + (dim0 / 2) + (dim1 / 2)) * 2 + 1] = Float(sintheta)
+        }
+        for k in 0..<(dim3 / 2) {
+          let theta = 0 * 1.0 / pow(2_000, Double(k) * 2 / Double(dim3))
+          let sintheta = sin(theta)
+          let costheta = cos(theta)
+          rotTensor[0, i, j, (k + (dim0 / 2) + (dim1 / 2) + (dim2 / 2)) * 2] = Float(costheta)
+          rotTensor[0, i, j, (k + (dim0 / 2) + (dim1 / 2) + (dim2 / 2)) * 2 + 1] = Float(sintheta)
+        }
+      }
+    }
+  }
+  var index = width * height
+  for (n, referenceSize) in referenceSizes.enumerated() {
+    let height = referenceSize.height
+    let width = referenceSize.width
+    for y in 0..<height {
+      for x in 0..<width {
+        let i = y * width + x + index
+        for j in 0..<heads {
+          for k in 0..<(dim0 / 2) {
+            let theta = Double(10 + n * 10) * 1.0 / pow(2_000, Double(k) * 2 / Double(dim0))
+            let sintheta = sin(theta)
+            let costheta = cos(theta)
+            rotTensor[0, i, j, k * 2] = Float(costheta)
+            rotTensor[0, i, j, k * 2 + 1] = Float(sintheta)
+          }
+          for k in 0..<(dim1 / 2) {
+            let theta = Double(y) * 1.0 / pow(2_000, Double(k) * 2 / Double(dim1))
+            let sintheta = sin(theta)
+            let costheta = cos(theta)
+            rotTensor[0, i, j, (k + (dim0 / 2)) * 2] = Float(costheta)
+            rotTensor[0, i, j, (k + (dim0 / 2)) * 2 + 1] = Float(sintheta)
+          }
+          for k in 0..<(dim2 / 2) {
+            let theta = Double(x) * 1.0 / pow(2_000, Double(k) * 2 / Double(dim2))
+            let sintheta = sin(theta)
+            let costheta = cos(theta)
+            rotTensor[0, i, j, (k + (dim0 / 2) + (dim1 / 2)) * 2] = Float(costheta)
+            rotTensor[0, i, j, (k + (dim0 / 2) + (dim1 / 2)) * 2 + 1] = Float(sintheta)
+          }
+          for k in 0..<(dim3 / 2) {
+            let theta = 0 * 1.0 / pow(2_000, Double(k) * 2 / Double(dim3))
+            let sintheta = sin(theta)
+            let costheta = cos(theta)
+            rotTensor[0, i, j, (k + (dim0 / 2) + (dim1 / 2) + (dim2 / 2)) * 2] = Float(costheta)
+            rotTensor[0, i, j, (k + (dim0 / 2) + (dim1 / 2) + (dim2 / 2)) * 2 + 1] = Float(sintheta)
+          }
+        }
+      }
+    }
+    index += height * width
+  }
+  let tokenOffset = index
+  for i in 0..<tokenLength {
+    for j in 0..<heads {
+      for k in 0..<(dim0 / 2) {
+        let theta = 0 * 1.0 / pow(2_000, Double(k) * 2 / Double(dim0))
+        let sintheta = sin(theta)
+        let costheta = cos(theta)
+        rotTensor[0, i + tokenOffset, j, k * 2] = Float(costheta)
+        rotTensor[0, i + tokenOffset, j, k * 2 + 1] = Float(sintheta)
+      }
+      for k in 0..<(dim1 / 2) {
+        let theta = 0 * 1.0 / pow(2_000, Double(k) * 2 / Double(dim1))
+        let sintheta = sin(theta)
+        let costheta = cos(theta)
+        rotTensor[0, i + tokenOffset, j, (k + (dim0 / 2)) * 2] = Float(costheta)
+        rotTensor[0, i + tokenOffset, j, (k + (dim0 / 2)) * 2 + 1] = Float(sintheta)
+      }
+      for k in 0..<(dim2 / 2) {
+        let theta = 0 * 1.0 / pow(2_000, Double(k) * 2 / Double(dim2))
+        let sintheta = sin(theta)
+        let costheta = cos(theta)
+        rotTensor[0, i + tokenOffset, j, (k + (dim0 / 2) + (dim1 / 2)) * 2] = Float(costheta)
+        rotTensor[0, i + tokenOffset, j, (k + (dim0 / 2) + (dim1 / 2)) * 2 + 1] = Float(sintheta)
+      }
+      for k in 0..<(dim3 / 2) {
+        let theta = Double(i) * 1.0 / pow(2_000, Double(k) * 2 / Double(dim3))
+        let sintheta = sin(theta)
+        let costheta = cos(theta)
+        rotTensor[0, i + tokenOffset, j, (k + (dim0 / 2) + (dim1 / 2) + (dim2 / 2)) * 2] = Float(
+          costheta)
+        rotTensor[0, i + tokenOffset, j, (k + (dim0 / 2) + (dim1 / 2) + (dim2 / 2)) * 2 + 1] =
+          Float(sintheta)
+      }
+    }
+  }
+  return rotTensor
+}
+
+func referenceFlux3Rope(
+  height: Int, width: Int, tokenLength: Int, referenceSizes: [(height: Int, width: Int)],
+  channels: Int, heads: Int = 1
+)
+  -> Tensor<Float>
+{
+  var rotTensor = Tensor<Float>(
+    .CPU,
+    .NHWC(
+      1, height * width + referenceSizes.reduce(0) { $0 + $1.height * $1.width } + tokenLength,
+      heads, channels))
+  let dim = channels / 4
+  assert(channels % 16 == 0)
+  // Each token has 4 position axes (unused, y, x, text / reference index), each takes channels / 4.
+  func setPositions(_ i: Int, _ positions: [Double]) {
+    for j in 0..<heads {
+      for (axis, position) in positions.enumerated() {
+        for k in 0..<(dim / 2) {
+          let theta = position * 1.0 / pow(10_000, Double(k) * 2 / Double(dim))
+          let sintheta = sin(theta)
+          let costheta = cos(theta)
+          rotTensor[0, i, j, (k + axis * (dim / 2)) * 2] = Float(costheta)
+          rotTensor[0, i, j, (k + axis * (dim / 2)) * 2 + 1] = Float(sintheta)
+        }
+      }
+    }
+  }
+  for y in 0..<height {
+    for x in 0..<width {
+      setPositions(y * width + x, [0, Double(y) * 0.5, Double(x) * 0.5, 0])
+    }
+  }
+  var index = height * width
+  for (n, referenceSize) in referenceSizes.enumerated() {
+    let height = referenceSize.height
+    let width = referenceSize.width
+    for y in 0..<height {
+      for x in 0..<width {
+        setPositions(
+          y * width + x + index, [0, Double(y) * 0.5, Double(x) * 0.5, Double(-1 - n)])
+      }
+    }
+    index += height * width
+  }
+  for i in 0..<tokenLength {
+    setPositions(i + index, [0, 0, 0, Double(i)])
+  }
+  return rotTensor
+}
