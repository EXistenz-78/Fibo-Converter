diff --git a/Libraries/SwiftDiffusion/Sources/ScheduledDiscretization.swift b/Libraries/SwiftDiffusion/Sources/ScheduledDiscretization.swift
index 64d6d10..59d62b1 100644
--- a/Libraries/SwiftDiffusion/Sources/ScheduledDiscretization.swift
+++ b/Libraries/SwiftDiffusion/Sources/ScheduledDiscretization.swift
@@ -15,6 +15,36 @@ extension Denoiser {
     case linearQuadratic = "linear_quadratic"
     case beta
 
+    /// The number `GenerationConfiguration.scheduler` carries: 0 is no scheduler in the request
+    /// (nil, so the generator keeps its own), then the cases in order. A number this build doesn't
+    /// know is also nil.
+    public init?(configurationValue: Int32) {
+      switch configurationValue {
+      case 1: self = .simple
+      case 2: self = .sgmUniform
+      case 3: self = .normal
+      case 4: self = .karras
+      case 5: self = .exponential
+      case 6: self = .linearQuadratic
+      case 7: self = .beta
+      default: return nil
+      }
+    }
+
+    /// The inverse of `init(configurationValue:)`; the sampler's own is 0.
+    public var configurationValue: Int32 {
+      switch self {
+      case .samplerDefault: return 0
+      case .simple: return 1
+      case .sgmUniform: return 2
+      case .normal: return 3
+      case .karras: return 4
+      case .exponential: return 5
+      case .linearQuadratic: return 6
+      case .beta: return 7
+      }
+    }
+
     /// EDM models have no timestep table for the t-space schedulers to walk; ComfyUI only offers
     /// them the sigma-space ones in practice, so the others fall back to the sampler's own.
     public func isSupported(by parameterization: Parameterization) -> Bool {
