--- /dev/null
+++ b/Libraries/SwiftDiffusion/Sources/SeamlessTile.swift
@@ -0,0 +1,55 @@
+import Foundation
+
+/// Seamless tile: the image repeats with no edge along the axes it wraps. The request carries it as
+/// `GenerationConfiguration.seamlessTile` (0 off, 1 left-right, 2 up-down, 3 both).
+public struct SeamlessTile: Equatable, Sendable {
+  public var wrapsHeight: Bool
+  public var wrapsWidth: Bool
+
+  public init(wrapsHeight: Bool, wrapsWidth: Bool) {
+    self.wrapsHeight = wrapsHeight
+    self.wrapsWidth = wrapsWidth
+  }
+
+  /// nil for 0 (off) and for a value this build doesn't know; 1 wraps the width only, 2 the height
+  /// only, 3 both.
+  public init?(configurationValue: Int8) {
+    switch configurationValue {
+    case 1: self.init(wrapsHeight: false, wrapsWidth: true)
+    case 2: self.init(wrapsHeight: true, wrapsWidth: false)
+    case 3: self.init(wrapsHeight: true, wrapsWidth: true)
+    default: return nil
+    }
+  }
+
+  /// The smallest number of turns a RoPE frequency makes over the tile period and still gets
+  /// snapped to a whole number of turns (slower ones become constant); nil when the version does
+  /// not support seamless tiles.
+  public static func minTurns(for version: ModelVersion) -> Double? {
+    switch version {
+    case .zImage:
+      return 1.0
+    case .krea2, .flux2, .flux2_9b, .flux2_4b, .flux3_5b:
+      return 0.5
+    default:
+      return nil
+    }
+  }
+}
+
+/// A RoPE frequency snapped to whole turns over `period`: `turns = round(ω·P/2π)`, or 0 when
+/// `ω·P/2π < minTurns`; the result is `turns·2π/P`. All in `Double`.
+public func torusFrequency(omega: Double, period: Double, minTurns: Double) -> Double {
+  let turns = omega * period / (2 * Double.pi)
+  guard turns >= minTurns else { return 0 }
+  return turns.rounded() * 2 * Double.pi / period
+}
+
+/// The RoPE angle of `position` on the torus: the position is taken modulo `period`, so
+/// `position` and `position + period` give the same angle (as a point on the circle).
+public func torusAngle(position: Double, omega: Double, period: Double, minTurns: Double) -> Double
+{
+  var wrapped = position.truncatingRemainder(dividingBy: period)
+  if wrapped < 0 { wrapped += period }
+  return wrapped * torusFrequency(omega: omega, period: period, minTurns: minTurns)
+}
