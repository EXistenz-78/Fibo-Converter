From 500c99590403f11861d2e1e349807062247435db Mon Sep 17 00:00:00 2001
From: Antonio D'Achille <existenz70@gmail.com>
Date: Thu, 19 Nov 2026 13:00:49 +0100
Subject: [PATCH 1/2] SwiftPM targets for ModelConverter and an i8x (8-bit S)
 quantizer

Used by the Fibo 2.0 converter app.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 Apps/QuantI8x/Quantizer.swift | 352 ++++++++++++++++++++++++++++++++++
 Package.swift                 |  22 +++
 2 files changed, 374 insertions(+)
 create mode 100644 Apps/QuantI8x/Quantizer.swift

diff --git a/Apps/QuantI8x/Quantizer.swift b/Apps/QuantI8x/Quantizer.swift
new file mode 100644
index 0000000..a68237d
--- /dev/null
+++ b/Apps/QuantI8x/Quantizer.swift
@@ -0,0 +1,352 @@
+// Row-wise 8-bit ("8-bit S", i8x) variant of ModelQuantizer, used by the Fibo converter app.
+import ArgumentParser
+import Diffusion
+import NNC
+
+@main
+struct Quantizer: ParsableCommand {
+  @Option(
+    name: .shortAndLong,
+    help: "The input file to be converted.")
+  var inputFile: String
+
+  @Option(
+    name: .shortAndLong,
+    help: """
+      The model version of the input file. Available versions:
+      v1, v2, kandinsky2.1, sdxl_base_v0.9, sdxl_refiner_v0.9, ssd_1b, svd_i2v,
+      wurstchen_v3.0_stage_c, wurstchen_v3.0_stage_b, sd3, pixart, auraflow,
+      flux1, sd3_large, hunyuan_video, wan_v2.1_1.3b, wan_v2.1_14b, hidream_i1,
+      hidream_o1,
+      qwen_image, wan_v2.2_5b, z_image, ernie_image, flux2, flux2_9b, flux2_4b, flux3_5b, fibo2,
+      cosmos2.5_2b, cosmos2.5_2.9b, ltx2, ltx2.3,
+      seedvr2_3b, seedvr2_7b, ideogram_4, krea_2, moss_image
+      """)
+  var modelVersion: String
+
+  @Option(name: .shortAndLong, help: "The output file after conversion")
+  var outputFile: String
+
+  @Flag(
+    help: """
+      Quantize a text encoder instead of a diffusion model: its projections become q8p and its
+      token embeddings and vision tower stay FP16, as in Draw Things' own Qwen3-VL 8-bit file.
+      """)
+  var textEncoder = false
+
+  mutating func run() throws {
+    // Convert string to ModelVersion enum
+    guard let version = ModelVersion(rawValue: modelVersion) else {
+      throw ValidationError("Invalid model version: \(modelVersion)")
+    }
+    // Now you can use 'version' as your ModelVersion enum
+    print("Converting \(inputFile), model version: \(version)")
+
+    let graph = DynamicGraph()
+    graph.openStore(
+      inputFile, flags: .readOnly, externalStore: TensorData.externalStore(filePath: inputFile)
+    ) { store in
+      let keys = store.keys
+
+      graph.openStore(outputFile) {
+        for key in keys {
+          guard let tensor = store.read(key, codec: [.q8p, .q8p, .ezm7, .externalData]) else {
+            continue
+          }
+
+          // First convert the tensor to FP16, and then to q8p.
+          let fp16 = Tensor<FloatType>(from: tensor)
+          let shape = fp16.shape
+          let squeezedDims = shape.reduce(0) { $1 > 1 ? 1 + $0 : $0 }
+          if textEncoder {
+            // Embeddings are a lookup, and the vision tower is small and reads pixels, so both
+            // stay FP16. Norms only get compressed.
+            if key.contains("tok_embeddings") || key.hasPrefix("__vision_model__") {
+              $0.write(key, tensor: fp16)
+            } else if squeezedDims > 1 {
+              $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+            } else {
+              $0.write(key, tensor: fp16, codec: .ezm7)
+            }
+            continue
+          }
+          switch version {
+          case .v1, .v2, .ssd1b, .svdI2v, .sdxlBase, .sdxlRefiner, .wurstchenStageB, .kandinsky21:
+            if key.contains("visual_proj") || key.contains("encoder_hid_proj") {
+              $0.write(key, tensor: tensor)
+              continue
+            }
+            if shape.count == 2 && squeezedDims > 1 {
+              $0.write(key, tensor: fp16, codec: [.q6p, .ezm7])
+            } else if shape.count == 4 && squeezedDims > 1 {
+              $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+            } else {
+              $0.write(key, tensor: fp16, codec: .ezm7)
+            }
+          case .wurstchenStageC:
+            if key.contains("text_emb") || key.contains("effnet") || key.contains("previewer") {
+              $0.write(key, tensor: fp16)
+            } else {
+              if shape.count == 2 && squeezedDims > 1 {
+                $0.write(key, tensor: fp16, codec: [.q6p, .ezm7])
+              } else if shape.count == 4 && squeezedDims > 1 {
+                $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+              } else {
+                $0.write(key, tensor: fp16, codec: .ezm7)
+              }
+            }
+          case .pixart:
+            if key.contains("embedder") || key.contains("shift_table") || key.contains("t_block") {
+              $0.write(key, tensor: fp16)
+            } else {
+              if squeezedDims > 1 {
+                $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+              } else {
+                $0.write(key, tensor: fp16, codec: .ezm7)
+              }
+            }
+          case .sd3, .sd3Large:
+            if key.contains("embedder") || key.contains("pos_embed") || key.contains("ada_ln") {
+              $0.write(key, tensor: fp16)
+            } else if key.contains("norm") {
+              $0.write(key, tensor: fp16, codec: [.ezm7])
+            } else {
+              if squeezedDims > 1 {
+                $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+              } else {
+                $0.write(key, tensor: fp16, codec: .ezm7)
+              }
+            }
+          case .auraflow:
+            if key.contains("embedder") || key.contains("pos_embed")
+              || key.contains("register_tokens")
+            {
+              $0.write(key, tensor: fp16)
+            } else if key.contains("norm") {
+              $0.write(key, tensor: fp16, codec: [.ezm7])
+            } else {
+              if squeezedDims > 1 {
+                if key.contains("ada_ln") || key.contains("-linear-") {
+                  $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                } else {
+                  $0.write(key, tensor: fp16, codec: [.q5p, .ezm7])
+                }
+              } else {
+                $0.write(key, tensor: fp16, codec: .ezm7)
+              }
+            }
+          case .flux1:
+            if key.contains("embedder") || key.contains("pos_embed") || key.contains("-linear-") {
+              $0.write(key, tensor: fp16)
+            } else {
+              if squeezedDims > 1 {
+                if key.contains("ada_ln") {
+                  $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                } else {
+                  if shape.count == 4 {  // Convolution.
+                    $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                  } else {
+                    $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                  }
+                }
+              } else {
+                $0.write(key, tensor: fp16, codec: .ezm7)
+              }
+            }
+          case .hunyuanVideo:
+            if key.contains("embedder") || key.contains("pos_embed") || key.contains("-linear-")
+              || key.contains("refiner_")
+            {
+              $0.write(key, tensor: fp16)
+            } else {
+              if squeezedDims > 1 {
+                if key.contains("ada_ln") {
+                  $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                } else {
+                  if shape.count == 4 {  // Convolution.
+                    $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                  } else {
+                    $0.write(key, tensor: fp16, codec: [.q5p, .ezm7])
+                  }
+                }
+              } else {
+                $0.write(key, tensor: fp16, codec: .ezm7)
+              }
+            }
+          case .wan21_1_3b, .wan22_5b:
+            if key.contains("embedder") || key.contains("pos_embed") || key.contains("-linear-") {
+              $0.write(key, tensor: fp16)
+            } else {
+              if squeezedDims > 1 {
+                if key.contains("ada_ln") {
+                  $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                } else {
+                  if shape.count == 4 {  // Convolution.
+                    $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                  } else {
+                    $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                  }
+                }
+              } else {
+                $0.write(key, tensor: fp16, codec: .ezm7)
+              }
+            }
+          case .wan21_14b:
+            if key.contains("embedder") || key.contains("pos_embed") || key.contains("-linear-") {
+              $0.write(key, tensor: fp16)
+            } else {
+              if squeezedDims > 1 {
+                if key.contains("ada_ln") {
+                  $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                } else {
+                  if shape.count == 4 {  // Convolution.
+                    $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                  } else {
+                    $0.write(key, tensor: fp16, codec: [.q6p, .ezm7])
+                  }
+                }
+              } else {
+                $0.write(key, tensor: fp16, codec: .ezm7)
+              }
+            }
+          case .hiDreamI1, .hiDreamO1:
+            if key.contains("embedder") || key.contains("pos_embed") || key.contains("-linear-") {
+              $0.write(key, tensor: fp16)
+            } else {
+              if squeezedDims > 1 {
+                if key.contains("ada_ln") {
+                  $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                } else {
+                  if shape.count == 4 {  // Convolution.
+                    $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                  } else if shape.count == 3 {  // MoE.
+                    $0.write(key, tensor: fp16, codec: [.q5p, .ezm7])
+                  } else {
+                    $0.write(key, tensor: fp16, codec: [.q6p, .ezm7])
+                  }
+                }
+              } else {
+                $0.write(key, tensor: fp16, codec: .ezm7)
+              }
+            }
+          case .qwenImage, .qwenImage2_1, .krea2, .ernieImage, .seedvr2_3b, .seedvr2_7b:
+            if key.contains("embedder") || key.contains("pos_embed") || key.contains("-linear-") {
+              $0.write(key, tensor: fp16)
+            } else {
+              if squeezedDims > 1 {
+                if key.contains("ada_ln") {
+                  $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                } else {
+                  if shape.count == 4 {  // Convolution.
+                    $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                  } else {
+                    $0.write(key, tensor: fp16, codec: [.q6p, .ezm7])
+                  }
+                }
+              } else {
+                $0.write(key, tensor: fp16, codec: .ezm7)
+              }
+            }
+          case .cosmos2_5_2b, .cosmos2_5_2_9b:
+            if key.contains("embedder") || key.contains("pos_embed") || key.contains("-linear-")
+              || key.contains("_linear_")
+            {
+              $0.write(key, tensor: fp16)
+            } else {
+              if squeezedDims > 1 {
+                if shape.count == 4 {  // Convolution.
+                  $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                } else {
+                  $0.write(key, tensor: fp16, codec: [.q6p, .ezm7])
+                }
+              } else {
+                $0.write(key, tensor: fp16, codec: .ezm7)
+              }
+            }
+          case .zImage:
+            if key.contains("embedder") || key.contains("pos_embed")
+              || key.contains("-linear_final-")
+            {
+              $0.write(key, tensor: fp16)
+            } else {
+              if squeezedDims > 1 {
+                if key.contains("ada_ln") {
+                  $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                } else {
+                  if shape.count == 4 {  // Convolution.
+                    $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                  } else {
+                    $0.write(key, tensor: fp16, codec: [.q6p, .ezm7])
+                  }
+                }
+              } else {
+                $0.write(key, tensor: fp16, codec: .ezm7)
+              }
+            }
+          case .ltx2, .ltx2_3, .longcatVideoAvatar1_5, .minimaxH3:
+            fatalError()
+          case .mossImage:
+            if tensor.dataType == .Float32 {
+              // time_embedder_2 is kept in FP32 to avoid FP16 underflow.
+              $0.write(key, tensor: tensor)
+            } else if key.contains("embedder") || key.contains("final_linear") {
+              $0.write(key, tensor: fp16)
+            } else {
+              if squeezedDims > 1 {
+                $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+              } else {
+                $0.write(key, tensor: fp16, codec: .ezm7)
+              }
+            }
+          case .minimaxH3Image:
+            $0.write(key, tensor: fp16)
+          case .fibo2:
+            // Embedders, the final projection, gist queries and gates stay in FP16.
+            if key.contains("embedder") || key.contains("final_linear")
+              || key.contains("latent_queries") || key.contains("cross_attn_gate")
+            {
+              $0.write(key, tensor: fp16)
+            } else {
+              if squeezedDims > 1 {
+                $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+              } else {
+                $0.write(key, tensor: fp16, codec: .ezm7)
+              }
+            }
+          case .flux3_5b:
+            if tensor.dataType == .Float32 {
+              // These projections are kept in FP32 to avoid FP16 underflow.
+              $0.write(key, tensor: tensor)
+            } else if key.contains("embedder") || key.contains("-linear-") {
+              $0.write(key, tensor: fp16)
+            } else {
+              if squeezedDims > 1 {
+                $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+              } else {
+                $0.write(key, tensor: fp16, codec: .ezm7)
+              }
+            }
+          case .flux2, .flux2_9b, .flux2_4b, .ideogram4:
+            if key.contains("embedder") || key.contains("pos_embed") || key.contains("-linear-") {
+              $0.write(key, tensor: fp16)
+            } else {
+              if squeezedDims > 1 {
+                if key.contains("ada_ln") {
+                  $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                } else {
+                  if shape.count == 4 {  // Convolution.
+                    $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                  } else {
+                    $0.write(key, tensor: fp16, codec: [.i8x, .ezm7])
+                  }
+                }
+              } else {
+                $0.write(key, tensor: fp16, codec: .ezm7)
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+}
