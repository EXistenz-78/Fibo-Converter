+/// The 3x3 convolution of the Wan decoder on a single frame (a causal 3x3x3 convolution reduces to
+/// it: the loader keeps the last temporal slice of its weights), with its 1-pixel spatial border.
+/// With `wrap == nil` it is exactly today's `Convolution` (same name, same zero border). With
+/// `wrap` the border on each wrapped axis comes from the opposite side (`WrapPad`) and the
+/// convolution's own border there is 0; the other axis keeps its zero border. Returns the
+/// convolution (for its weights) and the function that applies it to an NHWC input of the given
+/// shape (the depth is the batch). The shape matters only with `wrap`.
+public func WanFrameConvolution(filters: Int, wrap: SeamlessTile?, name: String) -> (
+  Convolution, (Model.IO, (depth: Int, height: Int, width: Int, channels: Int)) -> Model.IO
+) {
+  guard let wrap = wrap else {
+    let conv = Convolution(
+      groups: 1, filters: filters, filterSize: [3, 3],
+      hint: Hint(stride: [1, 1], border: Hint.Border(begin: [1, 1], end: [1, 1])),
+      format: .OIHW, name: name)
+    return (conv, { x, _ in conv(x) })
+  }
+  let borderHeight = wrap.wrapsHeight ? 0 : 1
+  let borderWidth = wrap.wrapsWidth ? 0 : 1
+  let conv = Convolution(
+    groups: 1, filters: filters, filterSize: [3, 3],
+    hint: Hint(
+      stride: [1, 1],
+      border: Hint.Border(begin: [borderHeight, borderWidth], end: [borderHeight, borderWidth])),
+    format: .OIHW, name: name)
+  return (
+    conv,
+    { x, shape in
+      guard wrap.wrapsHeight || wrap.wrapsWidth else { return conv(x) }
+      let pad = WrapPad(
+        batchSize: shape.depth, height: shape.height, width: shape.width,
+        channels: shape.channels, top: 1, left: 1, wrapsHeight: wrap.wrapsHeight,
+        wrapsWidth: wrap.wrapsWidth)
+      return conv(pad(x))
+    }
+  )
+}
